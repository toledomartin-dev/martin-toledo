---
import Base from '../layouts/Base.astro';
import { site } from '../i18n/content';

// Una sola 404 para todo el sitio: trae los dos idiomas y el script elige cuál mostrar
const copy = {
  es: {
    kicker: 'Error 404 · GPS sin señal',
    title: 'Recalculando ruta…',
    text: 'Esta dirección no figura en el mapa. Ni Nominatim la encuentra.',
    home: 'Volver al inicio',
    homeHref: '/',
    projects: 'Ver proyectos',
    projectsHref: '/#proyectos',
    hint: 'Tip: tocá los puntos.',
    secret: 'Ya rompiste el mapa cinco veces. Alguien con esa curiosidad debería escribirme:',
  },
  en: {
    kicker: 'Error 404 · GPS signal lost',
    title: 'Recalculating route…',
    text: "This address isn't on the map. Not even Nominatim can find it.",
    home: 'Back to home',
    homeHref: '/en/',
    projects: 'See projects',
    projectsHref: '/en/#proyectos',
    hint: 'Tip: click the dots.',
    secret: "You've broken the map five times. Someone that curious should write to me:",
  },
};
---

<Base lang="es" title="404 — Martín Toledo" description="Página no encontrada." alternate="/en/">
  <section class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-4 pt-28 pb-16 text-center">
    <div class="pointer-events-none absolute top-1/3 left-1/2 size-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/10 blur-[120px]" aria-hidden="true"></div>

    <!-- Las partículas arman el "404"; sin WebGL queda el número en texto -->
    <div class="relative h-[min(38vw,380px)] min-h-40 w-full max-w-5xl">
      <canvas id="p404" class="absolute inset-0 size-full cursor-crosshair touch-none" aria-hidden="true"></canvas>
      <p id="fallback" class="display text-gradient absolute inset-0 grid place-items-center text-[min(32vw,320px)] leading-none">404</p>
    </div>

    {
      (['es', 'en'] as const).map((l) => (
        <div data-lang={l} class:list={['relative mt-6 max-w-xl', l === 'en' && 'hidden']}>
          <p class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase">
            <span class="relative flex size-2">
              <span class="anim-pulse absolute inline-flex size-full rounded-full bg-accent" />
              <span class="relative inline-flex size-2 rounded-full bg-accent" />
            </span>
            {copy[l].kicker}
          </p>
          <h1 class="display text-gradient mt-5 text-4xl sm:text-6xl">{copy[l].title}</h1>
          <p class="mt-4 text-muted">{copy[l].text}</p>
          <p class="mx-auto mt-6 w-fit max-w-full truncate rounded-lg border border-line bg-card/60 px-3 py-2 font-mono text-[11px] text-muted backdrop-blur">
            GET <span class="req-path text-fg">/</span> → 404 · lat: NaN · lon: NaN
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={copy[l].homeHref} class="btn-glow magnetic inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold">
              {copy[l].home}
            </a>
            <a
              href={copy[l].projectsHref}
              class="magnetic inline-flex items-center gap-2 rounded-full border border-line bg-card/70 px-6 py-3 text-sm font-semibold backdrop-blur transition-colors hover:border-accent/60"
            >
              {copy[l].projects}
            </a>
          </div>
          <p class="hint mt-6 font-mono text-[11px] text-muted/70">{copy[l].hint}</p>
          <p class="secret mt-6 hidden text-sm text-muted">
            {copy[l].secret}{' '}
            <a href={`mailto:${site.email}`} class="text-accent hover:underline">
              {site.email}
            </a>
          </p>
        </div>
      ))
    }
  </section>
</Base>

<script>
  // Idioma: rutas /en/... o navegador en otro idioma → inglés
  const en = location.pathname.startsWith('/en') || !navigator.language.toLowerCase().startsWith('es');
  const lang = en ? 'en' : 'es';
  document.documentElement.lang = lang;
  document.querySelectorAll<HTMLElement>('[data-lang]').forEach((el) => el.classList.toggle('hidden', el.dataset.lang !== lang));
  const box = document.querySelector<HTMLElement>(`[data-lang="${lang}"]`)!;

  // La ruta que no existe, como si fuera un log del geocodificador
  box.querySelector('.req-path')!.textContent = decodeURIComponent(location.pathname);

  const hint = box.querySelector<HTMLElement>('.hint')!;
  hint.hidden = true;
  const canvas = document.getElementById('p404') as HTMLCanvasElement;
  import('../scripts/particles404')
    .then(({ init404 }) =>
      init404({
        canvas,
        onBurst: (n) => {
          if (n >= 5) box.querySelector('.secret')?.classList.remove('hidden');
        },
      }),
    )
    .then((ok) => {
      if (!ok) return;
      document.getElementById('fallback')?.remove();
      hint.hidden = false;
    })
    .catch(() => {});
</script>
