---
import Base from '../../layouts/Base.astro';
import NoteArticle from '../../components/NoteArticle.astro';
import { getNotes, notePath, translationOf, type Note } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes('es');
  return notes.map((note) => ({ params: { slug: note.data.slug }, props: { note } }));
}

const { note } = Astro.props as { note: Note };
const other = await translationOf(note);
---

<Base lang="es" title={`${note.data.title} — Martín Toledo`} description={note.data.description} alternate={other ? notePath(other) : undefined}>
  <NoteArticle note={note} />
</Base>
