---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeadMeta from '../components/HeadMeta.astro';
import Lightbox from '../components/Lightbox.astro';
import { t, type Lang } from '../i18n/content';
// La fuente principal se precarga: así el texto se dibuja directo con Inter y no salta al cambiar de fuente
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  alternate?: string; // ruta equivalente en el otro idioma
  home?: boolean;
  image?: { src: string; alt: string };
}

const { lang, title, description, alternate, home = false, image } = Astro.props;
const ui = t[lang];
const pageTitle = title ?? ui.meta.title;
const pageDescription = description ?? ui.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const otherLang = lang === 'es' ? 'en' : 'es';
const altHref = alternate ?? ui.switchLang.href;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={new URL(altHref, Astro.site)} />
    <HeadMeta lang={lang} title={pageTitle} description={pageDescription} canonical={canonical} image={image} />

    <script is:inline>
      // Aplica el tema guardado antes de pintar, para evitar el parpadeo
      try {
        const saved = localStorage.getItem('theme');
        const light = saved ? saved === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
        if (light) {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      } catch (e) {}

      // Entrada de cada página: lo marcado con data-enter espera a la fuente (así no salta) y aparece
      // suave, escalonado. Si algo falla, a los 2,5 s aparece igual.
      const root = document.documentElement;
      let introDone = () => {};
      try {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('enter-wait');
          const go = () => root.classList.replace('enter-wait', 'enter-go');
          const font = document.fonts ? document.fonts.load('450 1em "Inter Variable"') : Promise.resolve();
          const intro = new Promise((resolve) => (introDone = resolve));
          Promise.all([Promise.race([font, new Promise((r) => setTimeout(r, 1200))]), intro]).then(go, go);
          setTimeout(go, 2500);
        }
      } catch (e) {}

      // Pantalla de carga: solo al entrar al sitio (una vez por sesión) y si no se pidió reducir movimiento
      try {
        if (!sessionStorage.getItem('intro') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          sessionStorage.setItem('intro', '1');
          root.classList.add('intro');
          // Se va cuando la página terminó de cargar, con un mínimo para que se lea y un máximo por las dudas
          const t0 = performance.now();
          let gone = false;
          const leave = () => {
            if (gone) return;
            gone = true;
            setTimeout(() => {
              root.classList.add('intro-out');
              introDone();
              setTimeout(() => root.classList.remove('intro', 'intro-out'), 700);
            }, Math.max(0, 900 - (performance.now() - t0)));
          };
          window.addEventListener('load', leave, { once: true });
          setTimeout(leave, 2000);
        } else {
          introDone();
        }
      } catch (e) {
        introDone();
      }
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <div class="intro-screen" aria-hidden="true">
      <div class="intro-logo">
        <span class="intro-ring"></span>
        <span class="intro-mark">MT</span>
      </div>
      <p class="intro-name">Martín Toledo</p>
      <span class="intro-bar"><span></span></span>
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <Header lang={lang} home={home} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Lightbox closeLabel={ui.about.close} />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Aparición al entrar en pantalla (+ contadores)
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('visible');
            entry.target.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
              const end = Number(el.dataset.count);
              if (reduced) return;
              const start = performance.now();
              const step = (now: number) => {
                const k = Math.min(1, (now - start) / 1600);
                el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
                if (k < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            });
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Brillo que sigue al mouse en las tarjetas de vidrio
      document.querySelectorAll<HTMLElement>('.glass').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // Botones "magnéticos": se acercan levemente al cursor
      if (!reduced && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('.magnetic').forEach((btn) => {
          btn.style.transition = 'transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .3s ease';
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * 0.25;
            const y = (e.clientY - r.top - r.height / 2) * 0.35;
            btn.style.transform = `translate(${x}px, ${y}px)`;
          });
          btn.addEventListener('pointerleave', () => (btn.style.transform = ''));
        });
      }

      // Al presionar un botón: se hunde y rebota. Anima `scale`, que se suma al `transform` magnético
      if (!reduced) {
        document.addEventListener('pointerdown', (e) => {
          const el = (e.target as Element).closest<HTMLElement>('button, .btn-glow, .magnetic, [data-press]');
          el?.animate([{ scale: 1 }, { scale: 0.94, offset: 0.35 }, { scale: 1 }], {
            duration: 360,
            easing: 'cubic-bezier(.2,.7,.2,1)',
          });
        });
      }

      // Caché offline: solo en el sitio publicado (en desarrollo serviría archivos viejos)
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
