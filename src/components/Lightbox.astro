---
// Visor de imágenes: cualquier elemento con data-lightbox="<url>" abre la imagen en grande.
// La animación sale desde la miniatura (técnica FLIP) y vuelve a ella al cerrar.
// Si la miniatura es un recorte de la imagen grande, data-lightbox-crop="x y ancho alto" (fracciones)
// indica qué parte muestra, para que la animación termine exactamente en ese encuadre.
interface Props {
  closeLabel: string;
}

const { closeLabel } = Astro.props;
---

<dialog id="lightbox" class="lightbox" aria-label={closeLabel}>
  <button type="button" class="lightbox-close" aria-label={closeLabel}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  <img class="lightbox-img" alt="" />
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgb(7 8 11 / 0.88);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .lightbox.is-open::backdrop {
    opacity: 1;
  }
  .lightbox-img {
    max-width: min(92vw, 900px);
    max-height: 88dvh;
    border-radius: 1.25rem;
    cursor: pointer;
    transform-origin: top left;
  }
  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease, background 0.2s ease;
  }
  .lightbox-close svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .lightbox-close:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .lightbox.is-open .lightbox-close {
    opacity: 1;
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let origin: HTMLElement | null = null;
  let closing = false;

  const full = { transform: 'none', clipPath: 'inset(0px 0px 0px 0px round 20px)' };

  // Lleva la imagen grande a la miniatura sin deformarla: escala pareja (como object-cover)
  // y un recorte que se ajusta al encuadre de la miniatura, que puede tener otra proporción
  const fromThumb = () => {
    const thumb = origin?.querySelector('img') ?? origin;
    if (!thumb) return full;
    const a = thumb.getBoundingClientRect();
    const b = img.getBoundingClientRect();
    const [cx, cy, cw, ch] = (origin?.dataset.lightboxCrop ?? '0 0 1 1').split(' ').map(Number);
    // La zona de la imagen grande que se ve en la miniatura, en píxeles de la imagen grande
    const rw = cw * b.width;
    const rh = ch * b.height;
    const s = Math.max(a.width / rw, a.height / rh);
    const mx = cx * b.width + rw / 2;
    const my = cy * b.height + rh / 2;
    const left = mx - a.width / s / 2;
    const top = my - a.height / s / 2;
    const right = b.width - (mx + a.width / s / 2);
    const bottom = b.height - (my + a.height / s / 2);
    const tx = a.left + a.width / 2 - b.left - s * mx;
    const ty = a.top + a.height / 2 - b.top - s * my;
    // El radio se escala junto con la imagen: lo compensamos para que coincida con el de la miniatura
    const r = parseFloat(getComputedStyle(thumb).borderTopLeftRadius) || 0;
    return {
      transform: `translate(${tx}px, ${ty}px) scale(${s})`,
      clipPath: `inset(${top}px ${right}px ${bottom}px ${left}px round ${r / s}px)`,
    };
  };

  const open = async (trigger: HTMLElement) => {
    origin = trigger;
    img.src = trigger.dataset.lightbox!;
    img.alt = trigger.dataset.lightboxAlt ?? '';
    await img.decode().catch(() => {});
    document.documentElement.style.overflow = 'hidden';
    dialog.showModal();
    requestAnimationFrame(() => dialog.classList.add('is-open'));
    if (!reduced) {
      img.animate([fromThumb(), full], {
        duration: 520,
        easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
      });
    }
  };

  const close = async () => {
    if (closing || !dialog.open) return;
    closing = true;
    dialog.classList.remove('is-open');
    if (!reduced) {
      // fill: la imagen se queda sobre la miniatura hasta que se cierra el visor, sin un cuadro de diferencia
      await img.animate([full, fromThumb()], {
        duration: 380,
        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
        fill: 'forwards',
      }).finished.catch(() => {});
    }
    dialog.close();
    img.getAnimations().forEach((a) => a.cancel());
    document.documentElement.style.overflow = '';
    // Sin preventScroll el navegador puede mover la página para mostrar la foto enfocada
    origin?.focus({ preventScroll: true });
    closing = false;
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (trigger) {
      e.preventDefault();
      open(trigger);
    }
  });
  // Clic en el fondo, en la imagen o en la X: cierra
  dialog.addEventListener('click', close);
  // Escape: cerramos con animación en lugar del cierre instantáneo del navegador
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
</script>
