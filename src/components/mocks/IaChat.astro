---
// Asistente de ia-gateway: explica la pantalla y marca un valor atípico, en un ciclo de 10 s
import { t, type Lang } from '../../i18n/content';

interface Props {
  lang: Lang;
}

const ui = t[Astro.props.lang].bento.ia.mock;
const insightBars = [0.32, 0.4, 0.28, 0.36, 0.95, 0.3, 0.38];
---

<div class="relative overflow-hidden rounded-2xl border border-white/5 bg-[#0a0b0f] text-[11px] text-[#f1f2f4]" aria-hidden="true">
  <div class="flex items-center justify-between border-b border-white/5 px-4 py-2.5">
    <span class="font-mono text-[10px] tracking-wider text-[#8d939e] uppercase">{ui.screen}</span>
    <span class="flex gap-1.5"><span class="size-2 rounded-full bg-white/10"></span><span class="size-2 rounded-full bg-white/10"></span></span>
  </div>
  <div class="grid gap-4 p-4 sm:grid-cols-[1fr_1.2fr]">
    <!-- La "pantalla": recaudación por línea, una barra se dispara -->
    <div class="flex h-28 items-end gap-1.5 rounded-xl border border-white/5 bg-white/[.02] p-3">
      {insightBars.map((h) => <span class:list={['flex-1 rounded-sm', h > 0.9 ? 'ia-hot bg-accent' : 'bg-white/15']} style={`height:${h * 100}%`} />)}
    </div>
    <!-- El asistente: pregunta, respuesta que se escribe y hallazgo -->
    <div class="space-y-2">
      <p class="ia-step ml-auto w-fit rounded-xl rounded-br-sm bg-accent px-3 py-1.5 font-medium text-[#1a0b00]" style="--d:.2s">{ui.question}</p>
      <div class="ia-step rounded-xl rounded-bl-sm border border-white/5 bg-white/[.04] px-3 py-2 leading-relaxed text-[#c9ccd2]" style="--d:1.1s">
        {ui.answer.map((line, i) => <span class="ia-type block" style={`--d:${1.3 + i * 1.1}s`}>{line}</span>)}
      </div>
      <p class="ia-step w-fit rounded-2xl border border-accent/40 bg-accent/10 px-2.5 py-1 font-mono text-[10px] leading-relaxed text-accent" style="--d:3.8s">
        <span class="mr-1.5 inline-block size-1.5 rounded-full bg-accent align-middle"></span>{ui.insight} · <span class="text-[#c9ccd2]">{ui.insightNote}</span>
      </p>
    </div>
  </div>
</div>

<style>
  .ia-step,
  .ia-type {
    opacity: 0;
    animation: ia-in 10s ease infinite;
    animation-delay: var(--d, 0s);
  }
  .ia-type {
    animation-name: ia-type;
  }
  .ia-hot {
    animation: ia-hot 10s ease infinite;
  }
  @keyframes ia-in {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    4%,
    84% {
      opacity: 1;
      transform: none;
    }
    92%,
    100% {
      opacity: 0;
    }
  }
  @keyframes ia-type {
    0% {
      opacity: 1;
      clip-path: inset(0 100% 0 0);
    }
    12%,
    84% {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
    92%,
    100% {
      opacity: 0;
    }
  }
  @keyframes ia-hot {
    0%,
    36%,
    92%,
    100% {
      box-shadow: none;
    }
    42%,
    84% {
      box-shadow: 0 0 18px var(--accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ia-step,
    .ia-type,
    .ia-hot {
      animation: none;
      opacity: 1;
    }
  }
</style>
