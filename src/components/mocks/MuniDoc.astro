---
// La libreta: credencial con QR y una lista de requisitos cumplidos
---

<div class="flex gap-3" aria-hidden="true">
  <div class="flex-1 rounded-xl border border-line bg-bg-soft/60 p-3">
    <div class="flex items-center gap-2">
      <span class="size-6 rounded-full bg-accent/30"></span>
      <span class="h-1.5 w-12 rounded bg-line"></span>
    </div>
    <div class="mt-3 grid w-12 grid-cols-4 gap-0.5">
      {[1, 0, 1, 1, 0, 1, 0, 1, 1, 1, 0, 0, 0, 1, 1, 1].map((b) => <span class:list={['aspect-square rounded-[1px]', b ? 'bg-fg/70' : 'bg-transparent']} />)}
    </div>
  </div>
  <ul class="flex-1 space-y-2 rounded-xl border border-line bg-bg-soft/60 p-3">
    {
      [1, 1, 0].map((done) => (
        <li class="flex items-center gap-2">
          <span class:list={['grid size-3.5 place-items-center rounded-sm text-[8px]', done ? 'bg-accent text-accent-ink' : 'border border-line']}>
            {done ? '✓' : ''}
          </span>
          <span class="h-1.5 flex-1 rounded bg-line" />
        </li>
      ))
    }
  </ul>
</div>
