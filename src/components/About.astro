---
import { t, site, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].about;
---

<section id="sobre-mi" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <div class="grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <!-- Foto: al tocarla se abre en tamaño completo -->
    <button
      type="button"
      class="glass reveal group relative block aspect-[4/5] w-full max-w-md cursor-pointer justify-self-center p-2 text-left lg:justify-self-start"
      data-lightbox={site.photoFull}
      data-lightbox-alt={ui.photoAlt}
      aria-label={ui.zoom}
    >
      <picture>
        <source srcset="/img/foto-about.avif" type="image/avif" />
        <source srcset="/img/foto-about.webp" type="image/webp" />
        <img
          src={site.photoAbout}
          alt={ui.photoAlt}
          width="640"
          height="800"
          loading="lazy"
          decoding="async"
          class="size-full rounded-[1.1rem] object-cover transition duration-700 group-hover:scale-[1.02]"
        />
      </picture>
      <span class="pointer-events-none absolute inset-x-2 bottom-2 h-1/3 rounded-b-[1.1rem] bg-gradient-to-t from-black/60 to-transparent"></span>
      <span
        class="absolute right-5 bottom-5 grid size-10 place-items-center rounded-full border border-white/20 bg-black/40 text-white backdrop-blur transition-transform group-hover:scale-110"
        aria-hidden="true"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg
        >
      </span>
      <span class="absolute bottom-5 left-5 font-mono text-xs text-white/85">Córdoba, Argentina</span>
    </button>

    <div>
      <div class="reveal">
        <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
        <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>
      </div>

      <div class="reveal mt-8 space-y-4 text-base leading-relaxed text-muted sm:text-lg" style="--d:.06s">
        {ui.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <dl class="reveal mt-10 grid grid-cols-3 gap-4 border-t border-line pt-8" style="--d:.12s">
        {
          ui.facts.map((f) => (
            <div>
              <dt class="sr-only">{f.label}</dt>
              <dd class="display text-2xl sm:text-3xl">{f.value}</dd>
              <dd class="mt-1 text-xs leading-snug text-muted sm:text-sm">{f.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="reveal mt-10" style="--d:.18s">
        <p class="font-mono text-[10px] tracking-widest text-muted uppercase">{ui.offTitle}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {ui.off.map((o) => <li class="rounded-full border border-line bg-card/60 px-3 py-1.5 text-sm text-muted">{o}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
