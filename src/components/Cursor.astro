---
// Cursor propio: un punto que sigue al mouse y un anillo que lo sigue con inercia.
// Solo con mouse (en pantallas táctiles no existe); en campos de texto vuelve el cursor del sistema.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor-ring"></span>
  <span class="cursor-dot"></span>
</div>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    html.has-cursor,
    html.has-cursor * {
      cursor: none !important;
    }
    html.has-cursor :is(input:not([type='button'], [type='submit'], [type='checkbox'], [type='radio']), textarea, select, [contenteditable]) {
      cursor: text !important;
    }
  }
  .cursor {
    display: none;
  }
  /* Fuera del flujo: dentro del visor (que es una grilla) no tiene que ocupar lugar ni mover la imagen */
  html.has-cursor .cursor {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
  }
  .cursor-dot,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cursor.is-visible .cursor-dot,
  .cursor.is-visible .cursor-ring {
    opacity: 1;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--accent);
  }
  .cursor-ring {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 1.5px solid color-mix(in srgb, var(--fg) 45%, transparent);
  }
  /* La posición va en translate y el tamaño en scale: el navegador aplica primero el scale, así crece en su lugar */
  .cursor-ring {
    --s: 1;
    transition:
      opacity 0.2s ease,
      border-color 0.25s ease,
      background-color 0.25s ease,
      scale 0.3s cubic-bezier(0.3, 0.7, 0.4, 1);
    scale: var(--s);
  }
  .cursor-dot {
    transition:
      opacity 0.2s ease,
      scale 0.25s ease;
  }
  /* Sobre algo que se puede tocar: el anillo crece y se tiñe, el punto se esconde */
  .cursor.is-link .cursor-ring {
    --s: 1.6;
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .cursor.is-link .cursor-dot {
    scale: 0;
  }
  /* Sobre algo para apuntar con precisión (el juego del 404): anillo chico */
  .cursor.is-precise .cursor-ring {
    --s: 0.45;
    border-color: var(--accent);
  }
  .cursor.is-down .cursor-ring {
    --s: 0.8;
  }
  .cursor.is-link.is-down .cursor-ring {
    --s: 1.3;
  }
  .cursor.is-text .cursor-dot,
  .cursor.is-text .cursor-ring {
    opacity: 0;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.cursor')!;
  const dot = root.querySelector<HTMLElement>('.cursor-dot')!;
  const ring = root.querySelector<HTMLElement>('.cursor-ring')!;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const LINK = 'a, button, summary, label, select, [role="button"], [data-lightbox], [tabindex]:not([tabindex="-1"])';
  const TEXT = 'input:not([type="button"], [type="submit"], [type="checkbox"], [type="radio"]), textarea, [contenteditable]';
  const PRECISE = '.cursor-crosshair';

  // Al cambiar de página arranca donde estaba, en lugar de esperar a que se mueva el mouse
  let x = -100;
  let y = -100;
  try {
    const saved = JSON.parse(sessionStorage.getItem('cursor') ?? 'null');
    if (saved) [x, y] = saved;
  } catch {}
  let rx = x;
  let ry = y;
  let raf = 0;

  const place = (el: HTMLElement, px: number, py: number) => {
    el.style.translate = `${px}px ${py}px`;
  };

  // El anillo alcanza al punto de a poco; cuando llega, se deja de animar
  const tick = () => {
    rx += (x - rx) * 0.2;
    ry += (y - ry) * 0.2;
    if (Math.abs(x - rx) < 0.1 && Math.abs(y - ry) < 0.1) {
      rx = x;
      ry = y;
      raf = 0;
    } else {
      raf = requestAnimationFrame(tick);
    }
    place(ring, rx, ry);
  };

  // Un <dialog> abierto se dibuja por encima de todo: el cursor tiene que vivir adentro para verse
  const follow = () => {
    const host = document.querySelector('dialog[open]') ?? document.body;
    if (root.parentElement !== host) host.append(root);
  };

  const onMove = (e: PointerEvent) => {
    if (e.pointerType !== 'mouse') return;
    x = e.clientX;
    y = e.clientY;
    follow();
    root.classList.add('is-visible');
    place(dot, x, y);
    if (reduced) place(ring, (rx = x), (ry = y));
    else if (!raf) raf = requestAnimationFrame(tick);
  };

  const onOver = (e: PointerEvent) => {
    const el = e.target as Element;
    const text = !!el.closest?.(TEXT);
    root.classList.toggle('is-text', text);
    root.classList.toggle('is-link', !text && !!el.closest?.(LINK));
    root.classList.toggle('is-precise', !!el.closest?.(PRECISE));
  };

  const enable = () => {
    if (!fine.matches) return;
    document.documentElement.classList.add('has-cursor');
    place(dot, x, y);
    place(ring, x, y);
    if (x > 0) root.classList.add('is-visible');
  };

  document.addEventListener('pointermove', onMove, { passive: true });
  document.addEventListener('pointerover', onOver, { passive: true });
  // 'close' no burbujea: se escucha en captura para volver a la página apenas se cierra el visor
  document.addEventListener('close', follow, true);
  document.addEventListener('pointerdown', () => root.classList.add('is-down'));
  document.addEventListener('pointerup', () => root.classList.remove('is-down'));
  document.documentElement.addEventListener('pointerleave', () => root.classList.remove('is-visible'));
  window.addEventListener('pagehide', () => {
    try {
      sessionStorage.setItem('cursor', JSON.stringify([x, y]));
    } catch {}
  });
  // Si se conecta o desconecta un mouse (tablets con teclado), se prende o se apaga
  fine.addEventListener('change', () => (fine.matches ? enable() : document.documentElement.classList.remove('has-cursor')));
  enable();
</script>
