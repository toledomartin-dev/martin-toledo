---
import { t, type Lang } from '../i18n/content';
import { getNotes } from '../lib/notes';
import NoteCard from './NoteCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].notes;
const notes = await getNotes(lang);
---

<section class="mx-auto max-w-6xl px-4 pt-32 pb-24 sm:px-6 sm:pt-40">
  <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
  <h1 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.indexTitle}</h1>
  <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{ui.indexLead}</p>

  <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {notes.map((note, i) => <NoteCard note={note} lang={lang} delay={(i % 3) * 0.06} />)}
  </div>
</section>
