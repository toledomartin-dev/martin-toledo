---
import { t, stackRows, type Lang } from '../i18n/content';
import { brandIcon } from '../lib/icons';
import { projects, projectPath } from '../projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].stack;

// En qué proyectos aparece cada tecnología: mismo ícono o nombre contenido en el stack o el diagrama
const usedIn = (name: string, icon: string) => {
  const needle = name.toLowerCase();
  return projects
    .filter((p) => {
      const items = [...p.text[lang].stack.flatMap((g) => g.items), ...p.diagram.nodes.map((n) => ({ name: n.label, icon: n.icon }))];
      return items.some((i) => (icon && i.icon === icon) || i.name.toLowerCase().includes(needle));
    })
    .map((p) => ({ label: p.text[lang].kicker, href: projectPath(lang, p.key) }));
};
const usage = Object.fromEntries(stackRows.flatMap((row) => row.items.map((item) => [item.name, usedIn(item.name, item.icon)])));

const rows = stackRows.map((row, r) => ({
  label: row[lang],
  reverse: r % 2 === 1,
  duration: 38 + r * 6,
  items: row.items.map((item) => {
    const icon = brandIcon(item.icon, item.name);
    return { name: item.name, path: icon.path, initials: icon.initials, brand: icon.color };
  }),
}));
---

<section id="stack" class="py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
      <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>
      <p class="mt-4 text-muted">{ui.intro}</p>
    </div>
  </div>

  <div class="reveal mt-14 space-y-8">
    {
      rows.map((row) => (
        <div>
          <p class="mx-auto max-w-6xl px-4 font-mono text-[10px] tracking-widest text-muted uppercase sm:px-6">{row.label}</p>
          <div class="marquee mt-3" style={`--dur:${row.duration}s`}>
            <ul class:list={['track', row.reverse && 'reverse']}>
              {[0, 1].map((copy) =>
                row.items.map((item) => (
                  <li class="pr-3" aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
                    <button
                      type="button"
                      class="tech"
                      data-tech={item.name}
                      aria-pressed="false"
                      tabindex={copy === 1 ? -1 : undefined}
                      style={`--brand:${item.brand}`}
                    >
                      {item.path ? (
                        <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill="currentColor" aria-hidden="true">
                          <path d={item.path} />
                        </svg>
                      ) : (
                        <span class="grid size-6 shrink-0 place-items-center rounded-md border border-current font-mono text-[10px] font-bold" aria-hidden="true">
                          {item.initials}
                        </span>
                      )}
                      <span class="text-sm font-medium whitespace-nowrap">{item.name}</span>
                    </button>
                  </li>
                )),
              )}
            </ul>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Dónde usé la tecnología elegida -->
  <div class="mx-auto mt-8 max-w-6xl px-4 sm:px-6">
    <div class="glass min-h-[4.5rem] p-4 sm:p-5" data-usage={JSON.stringify(usage)} aria-live="polite">
      <p class="text-sm text-muted" data-usage-empty>{ui.hint}</p>
      <div class="hidden flex-wrap items-center gap-2" data-usage-list>
        <span class="mr-1 text-sm"><strong class="text-fg" data-usage-name></strong> <span class="text-muted">· {ui.usedIn}</span></span>
      </div>
      <p class="hidden text-sm" data-usage-daily><strong class="text-fg" data-usage-name></strong> <span class="text-muted">· {ui.daily}</span></p>
    </div>
  </div>
</section>

<style>
  /* Filas que se desplazan sin fin: el contenido va duplicado y se mueve la mitad del ancho */
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee var(--dur) linear infinite;
  }
  .track.reverse {
    animation-direction: reverse;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .tech {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 85%, transparent);
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }
  /* Al pasar el mouse o tocarla, la tarjeta toma el color de la marca */
  .tech:hover,
  .tech:focus-visible,
  .tech.lit {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    background: color-mix(in srgb, var(--brand) 12%, var(--card));
    box-shadow: 0 10px 30px -12px color-mix(in srgb, var(--brand) 60%, transparent);
  }
  .tech:hover {
    transform: translateY(-3px);
  }
  .tech span:last-child {
    color: var(--fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 1rem;
      row-gap: 0.75rem;
    }
    .track li[data-copy='1'] {
      display: none;
    }
  }
</style>

<script>
  // Tocar una tarjeta la deja pintada (y su copia en la fila) y muestra en qué proyectos se usó
  const box = document.querySelector<HTMLElement>('[data-usage]')!;
  const usage = JSON.parse(box.dataset.usage!) as Record<string, { label: string; href: string }[]>;
  const empty = box.querySelector<HTMLElement>('[data-usage-empty]')!;
  const list = box.querySelector<HTMLElement>('[data-usage-list]')!;
  const daily = box.querySelector<HTMLElement>('[data-usage-daily]')!;

  const select = (name: string | null) => {
    document.querySelectorAll<HTMLButtonElement>('.tech').forEach((el) => {
      const on = el.dataset.tech === name;
      el.classList.toggle('lit', on);
      el.setAttribute('aria-pressed', String(on));
    });
    list.querySelectorAll('a').forEach((a) => a.remove());
    const found = name ? usage[name] ?? [] : [];
    empty.classList.toggle('hidden', !!name);
    list.classList.toggle('hidden', !name || !found.length);
    list.classList.toggle('flex', !!name && !!found.length);
    daily.classList.toggle('hidden', !name || !!found.length);
    box.querySelectorAll('[data-usage-name]').forEach((el) => (el.textContent = name));
    for (const p of found) {
      const a = document.createElement('a');
      a.href = p.href;
      a.textContent = p.label;
      a.className = 'rounded-full border border-line px-3 py-1 text-sm transition-colors hover:border-accent/60 hover:text-accent';
      list.append(a);
    }
  };

  document.querySelectorAll<HTMLButtonElement>('.tech').forEach((btn) => {
    btn.addEventListener('click', () => select(btn.getAttribute('aria-pressed') === 'true' ? null : btn.dataset.tech!));
  });
</script>
