---
// Invitación a la consola: el botón del header pasa desapercibido. Entrar desde acá también la "enciende".
import { t, type Lang } from '../i18n/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].consoleInvite;
const href = lang === 'es' ? '/consola/' : '/en/console/';
// Las tapas de los juegos de mentira, abiertas en abanico
const covers = ['vice', 'ruinas', 'battle', 'springfield'];
const icons = [
  // teclado, trofeo, cuenta
  '<rect x="2.5" y="6" width="19" height="12" rx="2"/><path d="M6.5 10h.01M10 10h.01M14 10h.01M17.5 10h.01M7 14h10"/>',
  '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>',
  '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
];
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
  <div class="glass reveal group relative grid items-center gap-10 overflow-hidden p-7 sm:p-10 lg:grid-cols-[1.1fr_1fr] lg:gap-6">
    <div class="pointer-events-none absolute -top-1/2 right-0 -z-10 size-[520px] rounded-full bg-accent/10 blur-[110px]" aria-hidden="true"></div>
    <div>
      <p class="font-mono text-xs text-accent">{ui.kicker}</p>
      <h2 class="display text-gradient mt-3 text-4xl sm:text-5xl">{ui.title}</h2>
      <p class="mt-4 max-w-lg leading-relaxed text-muted">{ui.text}</p>
      <ul class="mt-6 grid gap-2.5 text-sm">
        {
          ui.points.map((p, i) => (
            <li class="flex items-center gap-3">
              <svg class="size-[18px] shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
              {p}
            </li>
          ))
        }
      </ul>
      <a href={href} data-console-link class="btn-glow magnetic mt-8 inline-flex items-center gap-2.5 rounded-full px-7 py-3.5 font-semibold">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 3v9"></path><path d="M6.4 6.4a8 8 0 1 0 11.2 0"></path>
        </svg>
        {ui.cta}
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>

    <!-- Abanico de tapas: se abre un poco más al pasar el mouse -->
    <a href={href} data-console-link class="ci-fan relative mx-auto -mt-4 block h-52 w-full max-w-md sm:mt-0 sm:h-72" aria-hidden="true" tabindex="-1">
      {
        covers.map((id, i) => (
          <img src={`/img/juegos/${id}-${lang}-tapa.webp`} alt="" loading="lazy" decoding="async" class="ci-cover" style={`--i:${i - 1.5};z-index:${4 - Math.round(Math.abs(i - 1.5) * 2)}`} width="360" height="360" />
        ))
      }
    </a>
  </div>
</section>

<style>
  .ci-fan {
    --gap: clamp(2.6rem, 7vw, 4.2rem);
  }
  .ci-cover {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(8.5rem, 22vw, 11rem);
    aspect-ratio: 1;
    border-radius: 16px;
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.7);
    transform: translate(-50%, -50%) translateX(calc(var(--i) * var(--gap))) rotate(calc(var(--i) * 7deg)) translateY(calc(var(--i) * var(--i) * 0.35rem));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .group:hover .ci-cover {
    transform: translate(-50%, -50%) translateX(calc(var(--i) * var(--gap) * 1.3)) rotate(calc(var(--i) * 10deg)) translateY(calc(var(--i) * var(--i) * 0.6rem - 0.5rem));
  }
  @media (prefers-reduced-motion: reduce) {
    .ci-cover {
      transition: none;
    }
  }
</style>
