---
import { t, links, type Lang } from '../i18n/content';
import BiciStats from './BiciStats.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].bento;

const terminal = [
  { text: '$ git tag v2.4.0 && git push origin main v2.4.0', tone: 'fg' },
  { text: '▸ build image ............ ✓  38s', tone: 'ok' },
  { text: '▸ run tests .............. ✓  12s', tone: 'ok' },
  { text: '▸ push → registry ........ ✓', tone: 'ok' },
  { text: '▸ deploy production ...... ✓', tone: 'ok' },
  { text: '  rollback ready · v2.3.9', tone: 'muted' },
];
const servers = ['app-01', 'api-01', 'db-01', 'proxy'];
const cpu = 'M0 38 L12 30 L24 33 L36 18 L48 24 L60 14 L72 20 L84 10 L96 16 L108 8 L120 14';
const spark = 'M0 50 L20 42 L40 46 L60 30 L80 34 L100 22 L120 28 L140 16 L160 20 L180 8 L200 12';
---

<section id="proyectos" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
    <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>
    <p class="mt-4 text-muted">{ui.intro}</p>
  </div>

  <div class="mt-14 grid auto-rows-[minmax(220px,auto)] gap-4 sm:grid-cols-2 lg:grid-cols-6">
    <!-- Entaxi: celular con mapa y viaje en curso -->
    <!-- Toda la tarjeta lleva al caso (link "estirado"); el link al sitio queda por encima -->
    <div class="glass reveal group relative flex flex-col overflow-hidden sm:col-span-2 lg:col-span-3 lg:row-span-2">
      <div class="p-7 sm:p-8">
        <p class="font-mono text-xs text-accent">{ui.entaxi.tag}</p>
        <h3 class="mt-3 text-2xl font-medium tracking-tight">{ui.entaxi.title}</h3>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">{ui.entaxi.text}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a href={ui.entaxi.href} class="inline-flex items-center gap-2 text-sm font-medium text-accent after:absolute after:inset-0 after:content-['']">
            {ui.entaxi.cta}
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <a
            href={links.cbataxi}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent/60 hover:text-accent"
          >
            cbataxi.com <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="pointer-events-none relative mt-auto flex justify-center px-8" aria-hidden="true">
        <div class="absolute bottom-0 left-1/2 h-48 w-72 -translate-x-1/2 rounded-full bg-accent/25 blur-3xl"></div>
        <div
          class="relative h-[420px] w-[260px] translate-y-12 overflow-hidden rounded-t-[2.2rem] border-[6px] border-b-0 border-[#20232b] bg-[#0b0d11] shadow-2xl transition-transform duration-500 group-hover:translate-y-6"
        >
          <svg viewBox="0 0 220 360" class="absolute inset-0 size-full" preserveAspectRatio="xMidYMid slice">
            <defs>
              <pattern id="streets" width="34" height="34" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
                <path d="M0 0H34M0 0V34" stroke="#1b1f27" stroke-width="5"></path>
              </pattern>
            </defs>
            <rect width="220" height="360" fill="#0e1015"></rect>
            <rect width="220" height="360" fill="url(#streets)"></rect>
            <g transform="translate(0 30)">
            <path d="M-10 190 C60 170 90 210 230 150" stroke="#162028" stroke-width="14" fill="none"></path>
            <path
              id="trip"
              d="M40 230 L70 178 L118 160 L132 112 L180 92 L190 40"
              fill="none"
              stroke="var(--accent)"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-dasharray="6 6"
            ></path>
            <circle cx="190" cy="40" r="7" fill="var(--accent)" opacity=".25"></circle>
            <circle cx="190" cy="40" r="4" fill="var(--accent)"></circle>
            <g>
              <circle r="9" fill="var(--accent)" opacity=".25"></circle>
              <circle r="5" fill="#fff"></circle>
              <animateMotion dur="7s" repeatCount="indefinite" rotate="auto">
                <mpath href="#trip"></mpath>
              </animateMotion>
            </g>
            </g>
          </svg>
          <div class="absolute inset-x-0 bottom-0 rounded-t-2xl border-t border-white/10 bg-[#15181f]/95 p-4 backdrop-blur">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400/10 px-2 py-0.5 text-[10px] font-medium text-emerald-300">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>{ui.entaxi.mock.status}
              </span>
              <span class="font-mono text-sm text-white">{ui.entaxi.mock.fare}</span>
            </div>
            <p class="mt-3 text-[10px] tracking-wide text-[#8d939e] uppercase">{ui.entaxi.mock.destLabel}</p>
            <p class="text-sm text-white">{ui.entaxi.mock.dest}</p>
            <div class="relative mt-3 flex h-10 items-center overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--accent)_18%,transparent)] p-1">
              <span class="grid size-8 place-items-center rounded-full bg-accent text-[#1a0b00]">→</span>
              <span class="flex-1 text-center text-[11px] text-white/80">{ui.entaxi.mock.slide}</span>
              <span class="anim-shimmer absolute inset-0"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Choferes: contador + actividad -->
    <div class="glass reveal flex flex-col justify-between p-7 lg:col-span-3" style="--d:.08s">
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-2 font-mono text-xs text-muted">
          <span class="relative flex size-2">
            <span class="anim-pulse absolute inline-flex size-full rounded-full bg-emerald-400"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
          </span>
          {ui.drivers.live}
        </span>
        <span class="font-mono text-xs text-muted">{ui.drivers.next}</span>
      </div>
      <div class="mt-6 flex items-end justify-between gap-6">
        <div>
          <p class="display text-6xl sm:text-7xl">~<span data-count="500">500</span></p>
          <p class="mt-2 text-sm text-muted">{ui.drivers.label}</p>
        </div>
        <svg viewBox="0 0 200 60" class="h-16 w-40 shrink-0 overflow-visible" aria-hidden="true">
          <defs>
            <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="var(--accent)" stop-opacity=".35"></stop>
              <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d={`${spark} L200 60 L0 60Z`} fill="url(#spark-fill)"></path>
          <path d={spark} fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="400" class="draw"></path>
          <circle cx="200" cy="12" r="3.5" fill="var(--accent)"></circle>
        </svg>
      </div>
    </div>

    <!-- CI/CD: terminal -->
    <div class="glass reveal flex flex-col p-7 lg:col-span-3" style="--d:.12s">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-medium tracking-tight">{ui.cicd.title}</h3>
          <p class="mt-1 max-w-sm text-sm leading-relaxed text-muted">{ui.cicd.text}</p>
        </div>
      </div>
      <div class="mt-5 flex-1 rounded-xl border border-white/5 bg-[#0a0b0f] p-4 font-mono text-[11px] leading-6" aria-hidden="true">
        <div class="mb-2 flex gap-1.5">
          <span class="size-2.5 rounded-full bg-[#ff5f57]"></span><span class="size-2.5 rounded-full bg-[#febc2e]"></span><span
            class="size-2.5 rounded-full bg-[#28c840]"></span>
        </div>
        {
          terminal.map((l, i) => (
            <p
              class:list={[
                'term-line truncate',
                l.tone === 'ok' && 'text-emerald-300/90',
                l.tone === 'muted' && 'text-[#8d939e]',
                l.tone === 'fg' && 'text-[#f1f2f4]',
              ]}
              style={`--d:${i * 0.7}s`}
            >
              {l.text}
            </p>
          ))
        }
        <span class="caret inline-block h-3.5 w-1.5 translate-y-0.5 bg-accent"></span>
      </div>
    </div>

    <!-- Monitoreo: mini panel -->
    <div class="glass reveal flex flex-col p-7 sm:col-span-2 lg:col-span-4" style="--d:.06s">
      <h3 class="text-lg font-medium tracking-tight">{ui.monitor.title}</h3>
      <p class="mt-1 max-w-md text-sm leading-relaxed text-muted">{ui.monitor.text}</p>
      <div class="mt-6 grid flex-1 gap-3 sm:grid-cols-3" aria-hidden="true">
        <div class="rounded-xl border border-line bg-bg-soft/60 p-4">
          <p class="font-mono text-[10px] text-muted uppercase">CPU</p>
          <svg viewBox="0 0 120 44" class="mt-3 h-14 w-full" preserveAspectRatio="none">
            <path d={`${cpu} L120 44 L0 44Z`} fill="url(#spark-fill)"></path>
            <path d={cpu} fill="none" stroke="var(--accent)" stroke-width="1.6" vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft/60 p-4">
          <p class="font-mono text-[10px] text-muted uppercase">Requests</p>
          <div class="mt-3 flex h-14 items-end gap-1.5">
            {
              [0.5, 0.8, 0.6, 0.9, 0.4, 0.7, 0.85, 0.55, 0.75].map((h, i) => (
                <span class="anim-bar flex-1 rounded-sm bg-accent/70" style={`height:100%;--from:${h * 0.5};--to:${h};--d:${i * 0.18}s`} />
              ))
            }
          </div>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft/60 p-4">
          <p class="font-mono text-[10px] text-muted uppercase">{ui.monitor.servers}</p>
          <ul class="mt-3 space-y-1.5 font-mono text-[11px]">
            {
              servers.map((s) => (
                <li class="flex items-center justify-between">
                  <span class="text-muted">{s}</span>
                  <span class="size-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px] shadow-emerald-400" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- SaldoBus: lectura NFC -->
    <div class="glass reveal flex flex-col p-7 lg:col-span-2" style="--d:.12s">
      <div class="relative grid h-32 place-items-center" aria-hidden="true">
        <span class="anim-pulse absolute size-20 rounded-full border border-accent/60"></span>
        <span class="anim-pulse absolute size-20 rounded-full border border-accent/60" style="animation-delay:.8s"></span>
        <div
          class="relative h-16 w-26 -rotate-6 rounded-lg bg-gradient-to-br from-accent-strong to-accent p-2 shadow-[0_10px_30px_-8px_var(--glow)]"
        >
          <span class="block h-2.5 w-4 rounded-sm bg-[#1a0b00]/30"></span>
          <span class="mt-5 block font-mono text-[8px] tracking-widest text-[#1a0b00]/70">MIFARE</span>
        </div>
      </div>
      <h3 class="mt-4 text-lg font-medium tracking-tight">{ui.saldobus.title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{ui.saldobus.text}</p>
      <p class="mt-auto pt-4 font-mono text-[11px] text-emerald-300/90">✓ {ui.saldobus.read} · {ui.saldobus.done}</p>
    </div>

    <!-- TuBondi: recorrido -->
    <a href={links.tubondi} target="_blank" rel="noopener noreferrer" class="glass reveal group flex flex-col p-7 lg:col-span-3" style="--d:.06s">
      <div class="relative mt-8 h-16" aria-hidden="true">
        <div class="absolute top-1/2 right-2 left-2 h-0.5 -translate-y-1/2 rounded bg-line"></div>
        <div class="absolute top-1/2 right-2 left-2 flex -translate-y-1/2 justify-between">
          {[0, 1, 2, 3, 4].map(() => <span class="size-3 rounded-full border-2 border-line bg-card" />)}
        </div>
        <div class="bus absolute top-1/2 left-2 -translate-y-1/2">
          <span
            class="block rounded-md bg-accent px-2 py-1 font-mono text-[10px] font-bold text-accent-ink shadow-[0_6px_20px_-4px_var(--glow)]"
            >BUS</span
          >
        </div>
      </div>
      <div class="mt-auto flex items-center justify-between pt-6">
        <h3 class="text-lg font-medium tracking-tight">{ui.tubondi.title}</h3>
        <span class="text-muted transition-colors group-hover:text-accent" aria-label={ui.visit}>↗</span>
      </div>
      <p class="mt-1 text-sm leading-relaxed text-muted">{ui.tubondi.text}</p>
    </a>

    <!-- Municipalidad: documento + checklist -->
    <div class="glass reveal flex flex-col p-7 lg:col-span-3" style="--d:.12s">
      <div class="flex gap-3" aria-hidden="true">
        <div class="flex-1 rounded-xl border border-line bg-bg-soft/60 p-3">
          <div class="flex items-center gap-2">
            <span class="size-6 rounded-full bg-accent/30"></span>
            <span class="h-1.5 w-12 rounded bg-line"></span>
          </div>
          <div class="mt-3 grid w-12 grid-cols-4 gap-0.5">
            {
              [1, 0, 1, 1, 0, 1, 0, 1, 1, 1, 0, 0, 0, 1, 1, 1].map((b) => (
                <span class:list={['aspect-square rounded-[1px]', b ? 'bg-fg/70' : 'bg-transparent']} />
              ))
            }
          </div>
        </div>
        <ul class="flex-1 space-y-2 rounded-xl border border-line bg-bg-soft/60 p-3">
          {
            [1, 1, 0].map((done) => (
              <li class="flex items-center gap-2">
                <span
                  class:list={[
                    'grid size-3.5 place-items-center rounded-sm text-[8px]',
                    done ? 'bg-accent text-accent-ink' : 'border border-line',
                  ]}
                >
                  {done ? '✓' : ''}
                </span>
                <span class="h-1.5 flex-1 rounded bg-line" />
              </li>
            ))
          }
        </ul>
      </div>
      <h3 class="mt-5 text-lg font-medium tracking-tight">{ui.muni.title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{ui.muni.text}</p>
      <a href={links.tulibreta} target="_blank" rel="noopener noreferrer" class="mt-auto pt-4 text-sm text-accent hover:underline">
        {ui.muni.libreta} ↗
      </a>
    </div>

    <!-- BiciCba: impacto real, con datos del sistema -->
    <BiciStats lang={lang} />
  </div>
</section>

<style>
  .draw {
    animation: dash 2.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-play-state: paused;
  }
  :global(.visible) .draw {
    animation-play-state: running;
  }
  .bus {
    animation: bus 6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes bus {
    0%,
    8% {
      left: 0.5rem;
    }
    46%,
    54% {
      left: calc(50% - 1.2rem);
    }
    92%,
    100% {
      left: calc(100% - 3rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bus {
      animation: none;
      left: calc(50% - 1.2rem);
    }
    .draw {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
