---
import { t, links, type Lang } from '../i18n/content';
import DetailLink from './DetailLink.astro';
import { projectPath } from '../projects';
import EntaxiPhone from './mocks/EntaxiPhone.astro';
import CicdTerminal from './mocks/CicdTerminal.astro';
import IaChat from './mocks/IaChat.astro';
import MonitorPanel from './mocks/MonitorPanel.astro';
import NfcCard from './mocks/NfcCard.astro';
import MuniDoc from './mocks/MuniDoc.astro';
import BikeStation from './mocks/BikeStation.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].bento;

const spark = 'M0 50 L20 42 L40 46 L60 30 L80 34 L100 22 L120 28 L140 16 L160 20 L180 8 L200 12';
---

<section id="proyectos" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
    <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>
    <p class="mt-4 text-muted">{ui.intro}</p>
  </div>

  <div class="mt-14 grid auto-rows-[minmax(220px,auto)] gap-4 sm:grid-cols-2 lg:grid-cols-6">
    <!-- Entaxi: celular con mapa y viaje en curso -->
    <!-- Toda la tarjeta lleva al caso (link "estirado"); el link al sitio queda por encima -->
    <div class="glass reveal group relative flex flex-col overflow-hidden sm:col-span-2 lg:col-span-3 lg:row-span-2">
      <div class="p-7 sm:p-8">
        <p class="font-mono text-xs text-accent">{ui.entaxi.tag}</p>
        <h3 class="mt-3 text-2xl font-medium tracking-tight">{ui.entaxi.title}</h3>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">{ui.entaxi.text}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a href={ui.entaxi.href} class="inline-flex items-center gap-2 text-sm font-medium text-accent after:absolute after:inset-0 after:content-['']">
            {ui.entaxi.cta}
            <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href={links.cbataxi}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent/60 hover:text-accent"
          >
            cbataxi.com <Icon name="arrow-up-right" class="size-3.5" />
          </a>
        </div>
      </div>
      <div class="mt-auto"><EntaxiPhone lang={lang} /></div>
    </div>

    <!-- Choferes: contador + actividad -->
    <div class="glass reveal flex flex-col justify-between p-7 lg:col-span-3" style="--d:.08s">
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-2 font-mono text-xs text-muted">
          <span class="relative flex size-2">
            <span class="anim-pulse absolute inline-flex size-full rounded-full bg-emerald-400"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
          </span>
          {ui.drivers.live}
        </span>
        <span class="font-mono text-xs text-muted">{ui.drivers.next}</span>
      </div>
      <div class="mt-6 flex items-end justify-between gap-6">
        <div>
          <p class="display text-6xl sm:text-7xl">~<span data-count="500">500</span></p>
          <p class="mt-2 text-sm text-muted">{ui.drivers.label}</p>
        </div>
        <svg viewBox="0 0 200 60" class="h-16 w-40 shrink-0 overflow-visible" aria-hidden="true">
          <defs>
            <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="var(--accent)" stop-opacity=".35"></stop>
              <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d={`${spark} L200 60 L0 60Z`} fill="url(#spark-fill)"></path>
          <path d={spark} fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="400" class="draw"></path>
          <circle cx="200" cy="12" r="3.5" fill="var(--accent)"></circle>
        </svg>
      </div>
    </div>

    <!-- CI/CD: terminal -->
    <div class="glass reveal group flex flex-col p-7 lg:col-span-3" style="--d:.12s">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-medium tracking-tight">{ui.cicd.title}</h3>
          <p class="mt-1 max-w-sm text-sm leading-relaxed text-muted">{ui.cicd.text}</p>
          <DetailLink href={projectPath(lang, 'cicd')} label={ui.detail} />
        </div>
      </div>
      <div class="mt-5 flex flex-1 flex-col"><CicdTerminal /></div>
    </div>

    <!-- ia-gateway: el asistente explica la pantalla y marca un valor atípico -->
    <div class="glass reveal group grid gap-6 p-7 sm:col-span-2 lg:col-span-6 lg:grid-cols-[1fr_1.35fr] lg:items-center" style="--d:.06s">
      <div>
        <p class="font-mono text-xs text-accent">{ui.ia.tag}</p>
        <h3 class="mt-3 text-2xl font-medium tracking-tight">{ui.ia.title}</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-muted">{ui.ia.text}</p>
        <DetailLink href={projectPath(lang, 'ia-gateway')} label={ui.detail} />
      </div>
      <IaChat lang={lang} />
    </div>

    <!-- Monitoreo: mini panel -->
    <div class="glass reveal group flex flex-col p-7 sm:col-span-2 lg:col-span-4" style="--d:.06s">
      <h3 class="text-lg font-medium tracking-tight">{ui.monitor.title}</h3>
      <p class="mt-1 max-w-md text-sm leading-relaxed text-muted">{ui.monitor.text}</p>
      <DetailLink href={projectPath(lang, 'monitoreo')} label={ui.detail} />
      <div class="mt-6 flex flex-1 flex-col"><MonitorPanel lang={lang} /></div>
    </div>

    <!-- SaldoBus: lectura NFC -->
    <div class="glass reveal group flex flex-col p-7 lg:col-span-2" style="--d:.12s">
      <NfcCard />
      <h3 class="mt-4 text-lg font-medium tracking-tight">{ui.saldobus.title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{ui.saldobus.text}</p>
      <p class="mt-3 inline-flex items-center gap-1.5 font-mono text-[11px] text-emerald-300/90"><Icon name="check" class="size-3.5" />{ui.saldobus.read} · {ui.saldobus.done}</p>
      <div class="mt-auto"><DetailLink href={projectPath(lang, 'saldobus')} label={ui.detail} /></div>
    </div>

    <!-- TuBondi: recorrido -->
    <a href={links.tubondi} target="_blank" rel="noopener noreferrer" class="glass reveal group flex flex-col p-7 lg:col-span-3" style="--d:.06s">
      <div class="relative mt-8 h-16" aria-hidden="true">
        <div class="absolute top-1/2 right-2 left-2 h-0.5 -translate-y-1/2 rounded bg-line"></div>
        <div class="absolute top-1/2 right-2 left-2 flex -translate-y-1/2 justify-between">
          {[0, 1, 2, 3, 4].map(() => <span class="size-3 rounded-full border-2 border-line bg-card" />)}
        </div>
        <div class="bus absolute top-1/2 left-2 -translate-y-1/2">
          <span
            class="block rounded-md bg-accent px-2 py-1 font-mono text-[10px] font-bold text-accent-ink shadow-[0_6px_20px_-4px_var(--glow)]"
            >BUS</span
          >
        </div>
      </div>
      <div class="mt-auto flex items-center justify-between pt-6">
        <h3 class="text-lg font-medium tracking-tight">{ui.tubondi.title}</h3>
        <span class="text-muted transition-colors group-hover:text-accent" aria-label={ui.visit}><Icon name="arrow-up-right" class="size-5" /></span>
      </div>
      <p class="mt-1 text-sm leading-relaxed text-muted">{ui.tubondi.text}</p>
    </a>

    <!-- Municipalidad: documento + checklist -->
    <div class="glass reveal group flex flex-col p-7 lg:col-span-3" style="--d:.12s">
      <MuniDoc />
      <h3 class="mt-5 text-lg font-medium tracking-tight">{ui.muni.title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{ui.muni.text}</p>
      <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2">
        <DetailLink href={projectPath(lang, 'muni')} label={ui.detail} />
        <a
          href={links.tulibreta}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 mt-4 inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent/60 hover:text-accent"
        >
          {ui.muni.libreta} <Icon name="arrow-up-right" class="size-3.5" />
        </a>
      </div>
    </div>

    <!-- BiciCba: un préstamo en la estación (los números del sistema están en la página del proyecto) -->
    <div class="glass reveal group grid gap-6 p-7 sm:col-span-2 lg:col-span-6 lg:grid-cols-[1fr_1.35fr] lg:items-center" style="--d:.06s">
      <div>
        <p class="font-mono text-xs text-accent">{ui.bicicba.tag}</p>
        <h3 class="mt-3 text-2xl font-medium tracking-tight">{ui.bicicba.title}</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-muted">{ui.bicicba.text}</p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <DetailLink href={projectPath(lang, 'bicicba')} label={ui.detail} />
          <a
            href={links.bicicba}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 mt-4 inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent/60 hover:text-accent"
          >
            bicicba.com <Icon name="arrow-up-right" class="size-3.5" />
          </a>
        </div>
      </div>
      <BikeStation lang={lang} />
    </div>
  </div>
</section>

<style>
  .draw {
    animation: dash 2.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-play-state: paused;
  }
  :global(.visible) .draw {
    animation-play-state: running;
  }
  .bus {
    animation: bus 6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes bus {
    0%,
    8% {
      left: 0.5rem;
    }
    46%,
    54% {
      left: calc(50% - 1.2rem);
    }
    92%,
    100% {
      left: calc(100% - 3rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bus {
      animation: none;
      left: calc(50% - 1.2rem);
    }
    .draw {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
