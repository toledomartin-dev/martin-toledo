---
// Íconos y metadatos para compartir (Open Graph / X), comunes a todas las páginas
import type { Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonical: URL;
}

const { lang, title, description, canonical } = Astro.props;
const image = new URL(`/og/og-${lang}.jpg`, Astro.site);
const alt =
  lang === 'es'
    ? 'Martín Toledo — Construyo sistemas que mueven ciudades. Mapa de Córdoba dibujado con puntos.'
    : 'Martín Toledo — I build systems that move cities. Map of Córdoba drawn with dots.';
---

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#07080b" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Martín Toledo" />
<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
