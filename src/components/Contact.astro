---
import { t, site, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].contact;
const social = [
  {
    href: site.linkedin,
    label: 'LinkedIn',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
  {
    href: site.github,
    label: 'GitHub',
    path: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3',
  },
];
---

<section id="contacto" class="mx-auto max-w-6xl px-4 pt-12 pb-28 sm:px-6">
  <div class="glass reveal relative px-6 py-20 text-center sm:px-12 sm:py-28">
    <!-- Sol naciente detrás del título -->
    <div class="pointer-events-none absolute -bottom-[60%] left-1/2 -z-10 aspect-square w-[130%] -translate-x-1/2 rounded-full sm:w-[90%]" aria-hidden="true">
      <div class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_0%,var(--accent)_0%,transparent_45%)] opacity-40 blur-2xl"></div>
      <div class="absolute inset-0 rounded-full border-t border-accent/60"></div>
    </div>

    <h2 class="display text-gradient mx-auto max-w-3xl text-4xl sm:text-6xl">{ui.title}</h2>
    <p class="mx-auto mt-5 max-w-md text-muted">{ui.text}</p>

    <a href={`mailto:${site.email}`} class="btn-glow magnetic mt-10 inline-flex items-center gap-2 rounded-full px-7 py-3.5 font-semibold">
      {ui.cta}
      <span aria-hidden="true">→</span>
    </a>
    <p class="mt-4 font-mono text-sm break-all text-muted">{site.email}</p>

    <div class="mt-10 flex justify-center gap-3">
      {
        social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-11 place-items-center rounded-full border border-line bg-card/60 text-muted backdrop-blur transition-colors hover:border-accent/60 hover:text-accent"
            aria-label={s.label}
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>
