---
import { t, site, type Lang } from '../i18n/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].contact;
const field =
  'w-full rounded-2xl border border-line bg-bg-soft/70 px-4 py-3 text-fg placeholder:text-muted/70 transition-colors focus:border-accent/70 focus:outline-none';
const label = 'flex flex-col gap-2 text-left';
const labelText = 'font-mono text-[11px] tracking-widest text-muted uppercase';
const social = [
  {
    href: site.linkedin,
    label: 'LinkedIn',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
  {
    href: site.github,
    label: 'GitHub',
    path: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3',
  },
];
---

<section id="contacto" class="mx-auto max-w-6xl px-4 pt-12 pb-28 sm:px-6">
  <div class="glass reveal relative px-6 py-20 text-center sm:px-12 sm:py-28">
    <!-- Sol naciente detrás del título -->
    <div class="pointer-events-none absolute -bottom-[60%] left-1/2 -z-10 aspect-square w-[130%] -translate-x-1/2 rounded-full sm:w-[90%]" aria-hidden="true">
      <div class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_0%,var(--accent)_0%,transparent_45%)] opacity-40 blur-2xl"></div>
      <div class="absolute inset-0 rounded-full border-t border-accent/60"></div>
    </div>

    <h2 class="display text-gradient mx-auto max-w-3xl text-4xl sm:text-6xl">{ui.title}</h2>
    <p class="mx-auto mt-5 max-w-md text-muted">{ui.text}</p>

    <!-- Formulario: API Gateway → Lambda (valida el captcha) → SES, que me manda el mensaje por mail -->
    <form
      class="ct-form mx-auto mt-10 grid max-w-xl gap-4"
      novalidate
      data-api={site.guestbookApi}
      data-sitekey={site.turnstileSiteKey}
      data-lang={lang}
      data-ui={JSON.stringify(ui.client)}
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class={label}>
          <span class={labelText}>{ui.form.name}</span>
          <input name="nombre" type="text" maxlength="80" required autocomplete="name" placeholder={ui.form.namePlaceholder} class={field} />
        </label>
        <label class={label}>
          <span class={labelText}>{ui.form.email}</span>
          <input name="email" type="email" maxlength="120" required autocomplete="email" placeholder={ui.form.emailPlaceholder} class={field} />
        </label>
      </div>
      <label class={label}>
        <span class={labelText}>{ui.form.message}</span>
        <textarea name="mensaje" rows="5" maxlength="3000" required placeholder={ui.form.messagePlaceholder} class={`${field} resize-y`}></textarea>
      </label>
      <!-- Trampa para bots: los humanos no ven este campo -->
      <input name="website" type="text" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] size-px opacity-0" aria-hidden="true" />
      <div class="ct-captcha min-h-[65px]"></div>
      <button type="submit" class="btn-glow magnetic inline-flex items-center justify-center gap-2 justify-self-center rounded-full px-7 py-3.5 font-semibold disabled:opacity-60">
        {ui.form.send}
        <Icon name="arrow-right" />
      </button>
      <p class="ct-status min-h-5 text-sm text-muted" aria-live="polite"></p>
    </form>

    <!-- Alternativa: copiar la dirección (muchos no tienen un cliente de correo configurado) -->
    <p class="mt-8 text-sm text-muted">{ui.form.or}</p>
    <div class="mt-3 flex justify-center">
      <button
        id="copy-email"
        type="button"
        data-email={site.email}
        class="group inline-flex max-w-full items-center gap-3 rounded-full border border-line bg-card/60 py-1.5 pr-1.5 pl-4 backdrop-blur transition-colors hover:border-accent/60"
      >
        <span class="truncate font-mono text-sm text-muted transition-colors group-hover:text-fg">{site.email}</span>
        <span class="relative inline-flex items-center gap-1.5 rounded-full bg-bg-soft px-3 py-1 text-xs font-medium text-fg">
          <svg class="copy-icon size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
            ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg
          >
          <svg class="check-icon hidden size-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"
            ><path d="m5 12 5 5L20 7"></path></svg
          >
          <span class="copy-label">{ui.copy}</span>
          <span class="copied-label hidden">{ui.copied}</span>
        </span>
      </button>
    </div>
    <p id="copy-status" class="sr-only" aria-live="polite"></p>

    <div class="mt-10 flex justify-center gap-3">
      {
        social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-11 place-items-center rounded-full border border-line bg-card/60 text-muted backdrop-blur transition-colors hover:border-accent/60 hover:text-accent"
            aria-label={s.label}
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  type Turnstile = {
    render: (el: HTMLElement, opciones: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };

  const form = document.querySelector<HTMLFormElement>('.ct-form');
  if (form) initForm(form);

  function initForm(form: HTMLFormElement) {
    const tx = JSON.parse(form.dataset.ui!) as Record<'sending' | 'sent' | 'verify' | 'invalid' | 'tooMany' | 'error', string>;
    const status = form.querySelector<HTMLElement>('.ct-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const captcha = form.querySelector<HTMLElement>('.ct-captcha')!;
    let turnstile: Turnstile | undefined;
    let widget = '';

    // El captcha se carga cuando el formulario está por verse. El script de Cloudflare puede estar
    // ya cargado (o cargándose) por el libro de visitas: en ese caso se reutiliza.
    function cargarCaptcha() {
      const render = () => {
        turnstile = (window as unknown as { turnstile: Turnstile }).turnstile;
        widget = turnstile.render(captcha, {
          sitekey: form.dataset.sitekey,
          language: form.dataset.lang,
          theme: document.documentElement.classList.contains('light') ? 'light' : 'dark',
          size: 'flexible',
        });
      };
      if ((window as unknown as { turnstile?: Turnstile }).turnstile) return render();
      const existing = document.querySelector<HTMLScriptElement>('script[src*="challenges.cloudflare.com/turnstile"]');
      if (existing) return existing.addEventListener('load', render);
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.onload = render;
      document.head.append(script);
    }
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        cargarCaptcha();
      },
      { rootMargin: '400px' },
    );
    io.observe(form);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const datos = new FormData(form);
      const nombre = String(datos.get('nombre') ?? '').trim();
      const email = String(datos.get('email') ?? '').trim();
      const mensaje = String(datos.get('mensaje') ?? '').trim();
      // Un bot llenó el campo trampa: hacemos como que salió bien y no mandamos nada
      if (datos.get('website')) {
        form.reset();
        status.textContent = tx.sent;
        return;
      }
      if (!nombre || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || mensaje.length < 10) {
        status.textContent = tx.invalid;
        return;
      }
      const token = turnstile?.getResponse(widget);
      if (!token) {
        status.textContent = tx.verify;
        return;
      }
      button.disabled = true;
      status.textContent = tx.sending;
      try {
        const res = await fetch(`${form.dataset.api}/contacto`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, email, mensaje, token }),
        });
        if (res.status === 429) throw new Error(tx.tooMany);
        if (res.status === 400) throw new Error(tx.invalid);
        if (!res.ok) throw new Error(tx.error);
        form.reset();
        status.textContent = tx.sent;
      } catch (err) {
        status.textContent = err instanceof Error && err.message ? err.message : tx.error;
      } finally {
        button.disabled = false;
        turnstile?.reset(widget); // cada token sirve una sola vez
      }
    });
  }

  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const status = document.getElementById('copy-status');
  let timer = 0;
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email!;
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // Sin permiso de portapapeles: seleccionamos el texto para que lo copien a mano
      const range = document.createRange();
      range.selectNodeContents(btn.querySelector('.truncate')!);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
      return;
    }
    const toggle = (done: boolean) => {
      btn.querySelector('.copy-icon')?.classList.toggle('hidden', done);
      btn.querySelector('.check-icon')?.classList.toggle('hidden', !done);
      btn.querySelector('.copy-label')?.classList.toggle('hidden', done);
      btn.querySelector('.copied-label')?.classList.toggle('hidden', !done);
    };
    toggle(true);
    if (status) status.textContent = btn.querySelector('.copied-label')?.textContent ?? '';
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      toggle(false);
      if (status) status.textContent = '';
    }, 2000);
  });
</script>
