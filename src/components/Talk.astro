---
import { t, site, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].talk;
const id = site.talkVideoId;
---

<section id="charlas" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
    <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>
  </div>

  <div class="glass reveal mt-14 grid items-center gap-8 p-4 sm:p-6 lg:grid-cols-[3fr_2fr]">
    <!-- El iframe de YouTube se carga recién al hacer clic, para que la página sea liviana -->
    <div class="yt-facade relative aspect-video overflow-hidden rounded-2xl bg-bg-soft" data-id={id} data-title={ui.name}>
      <button type="button" class="group absolute inset-0 size-full cursor-pointer" aria-label={ui.play}>
        <img
          src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
          alt=""
          loading="lazy"
          class="size-full object-cover opacity-70 transition duration-500 group-hover:scale-[1.02] group-hover:opacity-90"
        />
        <span class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></span>
        <span class="absolute inset-0 grid place-items-center">
          <span class="btn-glow grid size-16 place-items-center rounded-full transition-transform group-hover:scale-110">
            <svg class="ml-1 size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          </span>
        </span>
      </button>
    </div>

    <div class="p-2 sm:p-4">
      <p class="font-mono text-[10px] tracking-widest text-muted uppercase">{ui.event}</p>
      <h3 class="mt-3 text-2xl font-medium tracking-tight text-balance">{ui.name}</h3>
      <p class="mt-4 leading-relaxed text-muted">{ui.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={ui.caseHref} class="btn-glow inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold">
          {ui.caseCta} <span aria-hidden="true">→</span>
        </a>
        <a
          href={`https://www.youtube.com/watch?v=${id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline"
        >
          {ui.play} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1`;
      iframe.title = el.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 size-full';
      el.replaceChildren(iframe);
    });
  });
</script>
