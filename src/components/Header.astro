---
import { t, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  home: boolean;
  altHref: string;
}

const { lang, home, altHref } = Astro.props;
const ui = t[lang];
const base = lang === 'es' ? '/' : '/en/';
const anchor = (id: string) => (home ? `#${id}` : `${base}#${id}`);
const links = [
  { id: 'proyectos', label: ui.nav.projects },
  { id: 'experiencia', label: ui.nav.experience },
  { id: 'stack', label: ui.nav.stack },
  { id: 'charlas', label: ui.nav.talks },
];
---

<header class="fixed inset-x-0 top-0 z-40 px-4 pt-4 sm:px-6">
  <nav
    class="mx-auto flex h-14 max-w-6xl items-center justify-between rounded-full border border-line/80 bg-bg/60 pr-2 pl-3 shadow-[0_10px_40px_-20px_rgba(0,0,0,.6)] backdrop-blur-xl"
  >
    <a href={base} class="group flex items-center gap-2.5 font-medium tracking-tight" aria-label="Martín Toledo">
      <span class="relative grid size-8 place-items-center">
        <span class="absolute inset-0 rounded-full bg-accent/40 blur-md transition-opacity group-hover:opacity-100 opacity-60"></span>
        <span class="relative grid size-8 place-items-center rounded-full bg-accent font-mono text-[11px] font-bold text-accent-ink">MT</span>
      </span>
      <span class="hidden sm:inline">Martín Toledo</span>
    </a>

    <ul class="hidden items-center md:flex">
      {
        links.map((l) => (
          <li>
            <a href={anchor(l.id)} class="rounded-full px-4 py-2 text-sm text-muted transition-colors hover:text-fg">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        id="lang-switch"
        href={altHref}
        class="rounded-full px-3 py-2 font-mono text-xs font-semibold text-muted transition-colors hover:text-fg"
        hreflang={lang === 'es' ? 'en' : 'es'}
      >
        {ui.switchLang.label}
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:text-fg"
        aria-label={ui.theme}
        title={ui.theme}
      >
        <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <a href={anchor('contacto')} class="btn-glow magnetic ml-1 hidden rounded-full px-4 py-2 text-sm font-semibold sm:inline-flex">
        {ui.nav.contact}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full text-muted hover:text-fg md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <ul id="mobile-menu" class="mx-auto mt-2 hidden max-w-6xl rounded-3xl border border-line bg-bg/90 p-2 backdrop-blur-xl md:hidden">
    {
      [...links, { id: 'contacto', label: ui.nav.contact }].map((l) => (
        <li>
          <a href={anchor(l.id)} class="block rounded-2xl px-4 py-3 text-muted hover:bg-card hover:text-fg">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  import { initLangSwitch } from '../scripts/lang-switch';

  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const applyTheme = () => {
    const toLight = root.classList.contains('dark');
    root.classList.toggle('dark', !toLight);
    root.classList.toggle('light', toLight);
    try {
      localStorage.setItem('theme', toLight ? 'light' : 'dark');
    } catch (e) {}
  };

  // Cambio de tema: el tema nuevo se revela con un círculo que crece desde el botón
  const themeBtn = document.getElementById('theme-toggle')!;
  themeBtn.addEventListener('click', () => {
    if (!document.startViewTransition || reduced) return applyTheme();
    const r = themeBtn.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const transition = document.startViewTransition(applyTheme);
    // Si se toca de nuevo antes de terminar, el navegador corta la anterior: no es un error
    transition.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 700, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      })
      .catch(() => {});
  });

  initLangSwitch(document.getElementById('lang-switch') as HTMLAnchorElement);

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
