  </div>

  <!-- Encendido y apagado -->
  <div class="cs-boot" data-boot>
    <canvas class="cs-boot-canvas" aria-hidden="true"></canvas>
    <div class="cs-boot-logo" aria-hidden="true"><Logo class="size-full" /></div>
    <p class="cs-boot-press">
      <span class="cs-press-keys">{ui.press}</span>
      <span class="cs-press-touch">{ui.pressTouch}</span>
    </p>
    <p class="cs-boot-off" role="status">{ui.shutdown}</p>
    <button type="button" class="cs-icon-btn cs-boot-sound" data-sound-toggle aria-pressed="false" aria-label={all.sound} title={all.sound}>
      <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
