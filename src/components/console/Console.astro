        <path class="cs-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  import { initConsole } from '../../scripts/console/main';
  const root = document.querySelector<HTMLElement>('[data-console]');
  if (root) initConsole(root);
</script>

<style>
