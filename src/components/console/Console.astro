        <span class="cs-who-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" set:html={guestIcon} />
        </span>
        <span class="cs-who-name">{ui.who.guest}</span>
        <span class="cs-who-hint">{ui.who.guestHint}</span>
      </button>
      <!-- Sin sesión: logo de Google. Con sesión: la foto y el nombre de la cuenta (los pone el script) -->
      <button type="button" role="option" class="cs-who-user" data-user="google" aria-selected="false">
        <span class="cs-who-avatar" data-avatar>
