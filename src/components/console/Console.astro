  <!-- ¿Quién juega? (después del encendido) -->
  <div class="cs-who" data-who hidden>
    <h1 class="cs-who-title">{ui.who.title}</h1>
    <div class="cs-who-list" role="listbox" aria-label={ui.who.title}>
