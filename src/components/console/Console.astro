---
// Modo consola: los proyectos como juegos de una consola inventada (diseño propio, no imita a ninguna marca).
import { t, site, type Lang } from '../../i18n/content';
import { projects, projectPath } from '../../projects';
import { brandIcon } from '../../lib/icons';
import Logo from '../Logo.astro';
import Guestbook from '../Guestbook.astro';
import GameArt from './GameArt.astro';
import EntaxiPhone from '../mocks/EntaxiPhone.astro';
import IaChat from '../mocks/IaChat.astro';
import MonitorPanel from '../mocks/MonitorPanel.astro';
import CicdTerminal from '../mocks/CicdTerminal.astro';
import NfcCard from '../mocks/NfcCard.astro';
import MuniDoc from '../mocks/MuniDoc.astro';
import BikeStation from '../mocks/BikeStation.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].console;
const all = t[lang];
const home = lang === 'es' ? '/' : '/en/';
const otherLang = lang === 'es' ? { label: 'EN', href: '/en/console/' } : { label: 'ES', href: '/consola/' };

// Un color por juego: tiñe la portada, el fondo y los detalles
const colors: Record<string, string> = {
  entaxi: '#facc15',
  'ia-gateway': '#a78bfa',
  gps: '#38bdf8',
  monitoreo: '#34d399',
  cicd: '#fb923c',
  saldobus: '#22d3ee',
  muni: '#60a5fa',
  bicicba: '#f87171',
};

// Ícono de cada juego (trazos de 24 × 24): se lee bien aunque la tarjeta sea chica
const icons: Record<string, string> = {
  entaxi:
    '<path d="M10 2.5h4V5h-4z"/><path d="M5.5 11 7 6.8A2.5 2.5 0 0 1 9.4 5h5.2A2.5 2.5 0 0 1 17 6.8l1.5 4.2"/><rect x="3" y="11" width="18" height="6" rx="2"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>',
  'ia-gateway':
    '<path d="M21 12a8.5 8.5 0 0 1-12.3 7.6L3.5 21l1.4-4.6A8.5 8.5 0 1 1 21 12z"/><path d="M12 8l1 2.2 2.2 1-2.2 1L12 14.4l-1-2.2-2.2-1 2.2-1z"/>',
  gps: '<rect x="4" y="3" width="16" height="14" rx="3"/><path d="M4 10h16M8 3.5V10M16 3.5V10"/><circle cx="8" cy="13.5" r="1"/><circle cx="16" cy="13.5" r="1"/><path d="M7 17v3M17 17v3"/>',
  monitoreo: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M6.5 11H9l1.5-3 3 6 1.5-3h2.5M9 21h6M12 17v4"/>',
  cicd: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9.5 3 2.5-3 2.5M12.5 15H17"/>',
  saldobus: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M14 9.8a3 3 0 0 1 0 4.4M16.6 8.2a5.5 5.5 0 0 1 0 7.6M6 15h4"/>',
  muni: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  bicicba:
    '<circle cx="5.5" cy="16" r="3.5"/><circle cx="18.5" cy="16" r="3.5"/><path d="M5.5 16 9.5 9h6l3 7M9.5 9l3.5 7h5.5M8 6h3M14.5 6h2l1 3"/>',
  profile: '<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  guestbook: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5M9 8h7M9 11.5h5"/>',
  trophies:
    '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 6h2.5a1.5 1.5 0 0 1 0 3c-.8 1.6-1.6 2.3-2.7 2.7M7 6H4.5a1.5 1.5 0 0 0 0 3c.8 1.6 1.6 2.3 2.7 2.7"/>',
  exit: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
};
const guestIcon = icons.profile;
const google = brandIcon('siGoogle', 'Google');

const games = projects.map((p) => {
  const text = p.text[lang];
  const stack = text.stack
    .flatMap((g) => g.items)
    .filter((i) => i.icon)
    .slice(0, 6)
    .map((i) => ({ name: i.name, ...brandIcon(i.icon, i.name) }));
  return {
    id: p.key,
    title: text.kicker,
    headline: text.title,
    lead: text.lead,
    href: projectPath(lang, p.key),
    color: colors[p.key] ?? '#ff7a1a',
    diagram: p.diagram,
    facts: text.facts,
    sections: text.sections.slice(0, 2),
    stack,
    search: [text.kicker, text.title, ...stack.map((s) => s.name)].join(' ').toLowerCase(),
  };
});

const apps = [
  { id: 'profile', ...ui.apps.profile, color: '#ff7a1a', href: undefined },
  { id: 'guestbook', ...ui.apps.guestbook, color: '#ff9447', href: undefined },
  { id: 'trophies', ...ui.apps.trophies, color: '#fbbf24', href: undefined },
  { id: 'exit', ...ui.apps.exit, color: '#a3a9b3', href: home },
].map((a) => ({ ...a, search: [a.title, a.headline].join(' ').toLowerCase() }));

const tierColor = { bronze: '#d08b5b', silver: '#c7ccd6', gold: '#f5c542', platinum: '#a5d8ff' } as const;
const clientUi = JSON.stringify(ui.client);
// Login: la dirección de vuelta tiene que coincidir exacta con una de las cargadas en Cognito
const authConfig = JSON.stringify({ domain: site.cognitoDomain, clientId: site.cognitoClientId, path: lang === 'es' ? '/consola/' : '/en/console/' });
const trophyDefs = JSON.stringify(ui.trophyList);
---

<script is:inline>
  // La consola siempre es oscura. El encendido (y "¿Quién juega?") se ve solo al entrar con el botón
  // de la consola del sitio: ese botón deja una marca que se usa una sola vez. Al recargar, al volver
  // de un proyecto o al entrar directo por la dirección, se arranca en el inicio.
  document.documentElement.classList.remove('light');
  document.documentElement.classList.add('dark');
  try {
    if (sessionStorage.getItem('console-boot')) sessionStorage.removeItem('console-boot');
    else document.documentElement.classList.add('cs-skip-boot');
  } catch (e) {
    document.documentElement.classList.add('cs-skip-boot');
  }
</script>

<div class="console" data-console data-lang={lang} data-home={home} data-ui={clientUi} data-trophies={trophyDefs} data-auth={authConfig} data-input="keys">
  <!-- Fondo: el arte del elemento elegido (solo el activo se dibuja: los demás no gastan nada) -->
  <div class="cs-bg" aria-hidden="true">
    {
      games.map((g) => (
        <div class="cs-layer" data-bg={g.id} style={`--c:${g.color}`}>
          {g.id === 'gps' ? (
            <div class="cs-layer-art">
              <GameArt diagram={g.diagram} color={g.color} variant="hero" />
            </div>
          ) : (
            <div class="cs-layer-mock">
              {g.id === 'entaxi' && (
                <div class="glass cs-entaxi h-[400px] overflow-hidden pt-6">
                  <EntaxiPhone lang={lang} />
                </div>
              )}
              {g.id === 'ia-gateway' && (
                <div class="glass p-5">
                  <IaChat lang={lang} />
                </div>
              )}
              {g.id === 'monitoreo' && (
                <div class="glass flex p-5">
                  <MonitorPanel lang={lang} />
                </div>
              )}
              {g.id === 'cicd' && (
                <div class="glass flex p-5">
                  <CicdTerminal />
                </div>
              )}
              {g.id === 'saldobus' && (
                <div class="glass p-6">
                  <NfcCard />
                </div>
              )}
              {g.id === 'muni' && (
                <div class="glass p-5">
                  <MuniDoc />
                </div>
              )}
              {g.id === 'bicicba' && (
                <div class="glass p-5">
                  <BikeStation lang={lang} />
                </div>
              )}
            </div>
          )}
        </div>
      ))
    }
    {
      apps.map((a) => (
        <div class="cs-layer cs-layer-app" data-bg={a.id} style={`--c:${a.color}`}>
          <div class="cs-layer-mark">
            <Logo class="size-full" />
          </div>
        </div>
      ))
    }
    <div class="cs-vignette"></div>
  </div>

  <!-- Barra de arriba -->
  <header class="cs-top">
    <span class="size-8"><Logo class="size-8" /></span>
    <div class="flex items-center gap-1 sm:gap-2">
      <button type="button" class="cs-icon-btn" data-action="open" data-target="search" aria-label={ui.search.label} title={ui.search.label}>
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <button type="button" class="cs-icon-btn" data-sound-toggle aria-pressed="false" aria-label={all.sound} title={all.sound}>
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4z"></path>
          <path class="cs-sound-off" d="m16 9 5 6m0-6-5 6"></path>
          <path class="cs-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>
        </svg>
      </button>
      <a href={otherLang.href} class="cs-icon-btn font-mono text-xs font-semibold" hreflang={lang === 'es' ? 'en' : 'es'}>{otherLang.label}</a>
      <time class="hidden px-2 font-mono text-sm tabular-nums sm:block" data-clock></time>
      <button type="button" class="cs-user-btn" data-action="open" data-target="user" aria-label={ui.user.label} title={ui.user.label}>
        <span class="cs-user-avatar" data-avatar>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" set:html={guestIcon} />
          <img alt="" referrerpolicy="no-referrer" hidden />
        </span>
      </button>
    </div>
  </header>

  <!-- La fila: juegos | apps. La elegida muestra su nombre a la derecha -->
  <div class="cs-row" role="listbox" aria-label={ui.rowLabel} aria-orientation="horizontal">
    {
      games.map((g, i) => (
        <button
          type="button"
          role="option"
          class="cs-tile"
          aria-selected="false"
          tabindex="-1"
          aria-label={g.title}
          data-id={g.id}
          data-kind="game"
          data-href={g.href}
          data-color={g.color}
          style={`--c:${g.color};--i:${i}`}
        >
          <span class="cs-cover">
            <span class="cs-cover-texture">
              <GameArt diagram={g.diagram} color={g.color} variant="cover" />
            </span>
            <svg class="cs-cover-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[g.id]} />
          </span>
          <span class="cs-tile-name">{g.title}</span>
        </button>
      ))
    }
    <span class="cs-sep" aria-hidden="true"></span>
    {
      apps.map((a, i) => (
        <button
          type="button"
          role="option"
          class="cs-tile cs-tile-app"
          aria-selected="false"
          tabindex="-1"
          aria-label={a.title}
          data-id={a.id}
          data-kind="app"
          data-href={a.href}
          data-color={a.color}
          style={`--c:${a.color};--i:${games.length + i}`}
        >
          <span class="cs-cover">
            {a.id === 'profile' ? (
              <img src="/img/foto-avatar.webp" alt="" class="cs-app-photo" loading="lazy" />
            ) : (
              <svg class="cs-cover-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[a.id]} />
            )}
          </span>
          <span class="cs-tile-name">{a.title}</span>
        </button>
      ))
    }
  </div>

  <!-- Información del elemento elegido -->
  <section class="cs-infos">
    {
      games.map((g) => (
        <div class="cs-info" data-info={g.id} style={`--c:${g.color}`}>
          <p class="cs-kicker">{ui.gameKicker}</p>
          <h2 class="cs-title">{g.title}</h2>
          <p class="cs-headline">{g.headline}</p>
          <ul class="cs-stack" aria-label="Stack">
            {g.stack.map((s) => (
              <li title={s.name}>
                {s.path ? (
                  <svg viewBox="0 0 24 24" style={`fill:${s.color}`} aria-hidden="true">
                    <path d={s.path} />
                  </svg>
                ) : (
                  <span>{s.initials}</span>
                )}
                <span class="sr-only">{s.name}</span>
              </li>
            ))}
          </ul>
          <div class="cs-actions">
            <a href={g.href} class="cs-btn cs-btn-primary" data-action="play">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
              {ui.play}
            </a>
            <button type="button" class="cs-btn" data-action="details">
              {ui.details}
            </button>
          </div>
        </div>
      ))
    }
    {
      apps.map((a) => (
        <div class="cs-info" data-info={a.id} style={`--c:${a.color}`}>
          <p class="cs-kicker">{ui.appKicker}</p>
          <h2 class="cs-title">{a.title}</h2>
          <p class="cs-headline">{a.lead}</p>
          {a.id === 'trophies' && (
            <div class="cs-progress">
              <span class="cs-bar" data-trophy-bar>
                <span />
              </span>
              <span class="font-mono text-xs text-muted" data-trophy-count />
            </div>
          )}
          <div class="cs-actions">
            <a href={a.href ?? '#'} class="cs-btn cs-btn-primary" data-action="play">
              {ui.open}
            </a>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Ayudas de controles (cambian según teclado o joystick; en touch no se muestran) -->
  <footer class="cs-hints" aria-hidden="true">
    <span class="cs-hints-keys">
      <span><kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> {ui.hints.move}</span>
      <span><kbd>Enter</kbd> {ui.hints.play}</span>
      <span><kbd>D</kbd> {ui.hints.details}</span>
      <span><kbd>/</kbd> {ui.hints.search}</span>
      <span><kbd>Esc</kbd> {ui.hints.back}</span>
    </span>
    <span class="cs-hints-pad">
      <span><kbd class="pad">✛</kbd> {ui.hints.move}</span>
      <span><kbd class="pad">A</kbd> {ui.hints.play}</span>
      <span><kbd class="pad">Y</kbd> {ui.hints.details}</span>
      <span><kbd class="pad">B</kbd> {ui.hints.back}</span>
    </span>
  </footer>

  <!-- Paneles -->
  {
    games.map((g) => (
      <dialog class="cs-dialog" data-panel={`details-${g.id}`} style={`--c:${g.color}`} aria-labelledby={`dlg-${g.id}`}>
        <div class="cs-dialog-head">
          <div>
            <p class="cs-kicker">{g.title}</p>
            <h2 id={`dlg-${g.id}`} class="mt-2 text-2xl font-medium tracking-tight text-balance sm:text-3xl">
              {g.headline}
            </h2>
          </div>
          <button type="button" class="cs-icon-btn" data-close aria-label={ui.close}>
            ✕
          </button>
        </div>
        <dl class="cs-facts">
          {g.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 leading-relaxed text-muted">{g.lead}</p>
        {g.sections.map((s) => (
          <div class="mt-6">
            <h3 class="font-medium">{s.h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.p[0]}</p>
          </div>
        ))}
        <div class="cs-actions mt-8">
          <a href={g.href} class="cs-btn cs-btn-primary" data-action="play" autofocus>
            {ui.play}
          </a>
          <button type="button" class="cs-btn" data-close>
            {ui.close}
          </button>
        </div>
      </dialog>
    ))
  }

  <dialog class="cs-dialog" data-panel="profile" aria-labelledby="dlg-profile">
    <div class="cs-dialog-head">
      <div class="flex items-center gap-4">
        <img src="/img/foto-avatar.webp" alt="" width="72" height="72" class="cs-photo" />
        <div>
          <h2 id="dlg-profile" class="text-2xl font-medium tracking-tight">{site.name}</h2>
          <p class="text-muted">{all.hero.role}</p>
        </div>
      </div>
      <button type="button" class="cs-icon-btn" data-close aria-label={ui.close}>✕</button>
    </div>
    <dl class="cs-facts">
      <div><dt>{ui.profile.projects}</dt><dd>{games.length}</dd></div>
      <div><dt>{ui.profile.base}</dt><dd>{all.hero.location}</dd></div>
    </dl>
    <p class="mt-6 leading-relaxed text-muted">{all.meta.description}</p>
    <div class="cs-actions mt-8">
      <a href={all.cvFile} download={all.cvName} class="cs-btn cs-btn-primary" autofocus>{ui.profile.cv}</a>
      <a href={`mailto:${site.email}`} class="cs-btn">{ui.profile.email}</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="cs-btn">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="cs-btn">GitHub</a>
    </div>
  </dialog>

  <dialog class="cs-dialog cs-dialog-wide" data-panel="guestbook" aria-labelledby="dlg-guestbook">
    <div class="cs-dialog-head">
      <div>
        <p class="cs-kicker">{ui.appKicker}</p>
        <h2 id="dlg-guestbook" class="mt-2 text-2xl font-medium tracking-tight sm:text-3xl">{ui.apps.guestbook.title}</h2>
        <p class="mt-2 text-sm text-muted">{ui.apps.guestbook.lead}</p>
      </div>
      <button type="button" class="cs-icon-btn" data-close aria-label={ui.close}>✕</button>
    </div>
    <div class="mt-6">
      <Guestbook lang={lang} bare />
    </div>
  </dialog>

  <dialog class="cs-dialog" data-panel="trophies" aria-labelledby="dlg-trophies">
    <div class="cs-dialog-head">
      <div>
        <p class="cs-kicker">{ui.appKicker}</p>
        <h2 id="dlg-trophies" class="mt-2 text-2xl font-medium tracking-tight sm:text-3xl">{ui.apps.trophies.title}</h2>
        <div class="cs-progress mt-3">
          <span class="cs-bar" data-trophy-bar><span></span></span>
          <span class="font-mono text-xs text-muted" data-trophy-count></span>
        </div>
      </div>
      <button type="button" class="cs-icon-btn" data-close aria-label={ui.close}>✕</button>
    </div>
    <ul class="cs-trophies">
      {
        ui.trophyList.map((tr) => (
          <li class="cs-trophy" data-trophy={tr.id} style={`--t:${tierColor[tr.tier as keyof typeof tierColor]}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.trophies} />
            <div class="min-w-0">
              <p class="font-medium">{tr.name}</p>
              <p class="text-sm text-muted">{tr.desc}</p>
            </div>
            <span class="cs-tier">
              {ui.trophyTiers[tr.tier as keyof typeof ui.trophyTiers]}
              <span class="block text-[10px] opacity-70" data-trophy-state />
            </span>
          </li>
        ))
      }
    </ul>
  </dialog>

  <!-- Menú del usuario (arriba a la derecha) -->
  <dialog class="cs-dialog cs-menu" data-panel="user" aria-label={ui.user.label}>
    <div class="flex items-center gap-3">
      <span class="cs-user-avatar size-12" data-avatar>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" set:html={guestIcon} />
        <img alt="" referrerpolicy="no-referrer" hidden />
      </span>
      <div>
        <p class="font-medium" data-user-name>{ui.who.guest}</p>
        <p class="font-mono text-xs text-muted">{ui.user.level} <span data-level>1</span></p>
      </div>
    </div>
    <div class="cs-progress">
      <span class="cs-bar" data-trophy-bar><span></span></span>
      <span class="font-mono text-xs text-muted" data-trophy-count></span>
    </div>
    <div class="cs-menu-list">
      <!-- Íconos de trazo (24 × 24): trofeo, dos personas, salir por una puerta, encendido -->
      <button type="button" data-action="open" data-target="trophies" autofocus>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>
        {ui.user.trophies}
      </button>
      <button type="button" data-action="switch">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.5a6.5 6.5 0 0 1 3 5.5"/></svg>
        {ui.user.switch}
      </button>
      <button type="button" data-action="signout" hidden>
