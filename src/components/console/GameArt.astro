---
// Arte de un "juego" de la consola: el diagrama de arquitectura real del proyecto, dibujado como una
// constelación. En la portada va chico y quieto; de fondo va grande y con datos viajando por las líneas.
import type { Diagram } from '../../projects/types';
import { brandIcon } from '../../lib/icons';

interface Props {
  diagram: Diagram;
  color: string;
  variant: 'cover' | 'hero';
}

const { diagram, color, variant } = Astro.props;
const hero = variant === 'hero';
const r = hero ? 30 : 34; // en la portada se achica todo el dibujo, así que los nodos van más grandes
const byId = Object.fromEntries(diagram.nodes.map((n) => [n.id, n]));
const nodes = diagram.nodes.map((n) => ({ ...n, icon: brandIcon(n.icon, n.label) }));
---

<svg class:list={['game-art', `game-art-${variant}`]} viewBox={`0 0 960 ${diagram.height}`} style={`--art:${color}`} aria-hidden="true">
  <g class="art-edges">
    {
      diagram.edges.map((e, i) => {
        const a = byId[e.from];
        const b = byId[e.to];
        return (
          <line
            x1={a.at[0]}
            y1={a.at[1]}
            x2={b.at[0]}
            y2={b.at[1]}
            class:list={['art-edge', e.dashed && 'art-edge-dashed']}
            style={`--d:${(i * 0.37) % 2.2}s`}
          />
        );
      })
    }
  </g>
  <g class="art-nodes">
    {
      nodes.map((n) => (
        <g transform={`translate(${n.at[0]} ${n.at[1]})`} class:list={['art-node', n.core && 'art-node-core']}>
          <circle r={r} />
          {n.icon.path ? (
            <path d={n.icon.path} transform={`translate(${-r * 0.5} ${-r * 0.5}) scale(${r / 24})`} class="art-icon" />
          ) : (
            <text text-anchor="middle" dominant-baseline="central" class="art-initials" font-size={r * 0.7}>
              {n.icon.initials}
            </text>
          )}
          {hero && (
            <text y={r + 22} text-anchor="middle" class="art-label">
              {n.label}
            </text>
          )}
        </g>
      ))
    }
  </g>
</svg>

<style>
  .game-art {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .art-edge {
    stroke: color-mix(in srgb, var(--art) 55%, transparent);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .art-edge-dashed {
    stroke-dasharray: 8 10;
  }
  .art-node circle {
    fill: #0d0f14;
    stroke: color-mix(in srgb, var(--art) 45%, #2c3038);
    stroke-width: 2.5;
  }
  .art-node-core circle {
    fill: color-mix(in srgb, var(--art) 22%, #0d0f14);
    stroke: var(--art);
  }
  .art-icon {
    fill: #e7e9ee;
  }
  .art-initials {
    fill: #e7e9ee;
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .art-label {
    fill: #a3a9b3;
    font-family: var(--font-mono);
    font-size: 15px;
  }

  /* De fondo: los datos viajan por las conexiones y las piezas centrales laten */
  .game-art-hero .art-edge {
    stroke-dasharray: 3 14;
    animation: art-flow 2.4s linear infinite;
    animation-delay: calc(var(--d) * -1);
  }
  .game-art-hero .art-node-core circle {
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--art) 70%, transparent));
    animation: art-pulse 3.2s ease-in-out infinite;
  }
  @keyframes art-flow {
    to {
      stroke-dashoffset: -34;
    }
  }
  @keyframes art-pulse {
    50% {
      stroke-width: 5;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .game-art-hero .art-edge,
    .game-art-hero .art-node-core circle {
      animation: none;
    }
  }
</style>
