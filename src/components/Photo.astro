---
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../i18n/content';

// Si todavía no está la foto en public/, muestra las iniciales
const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public', site.photo));
---

{
  // Sin foto no mostramos nada: las iniciales ya están en el logo
  hasPhoto && (
    <span class="relative block size-11 shrink-0">
      <span class="absolute -inset-1 rounded-full bg-accent/30 blur-md" aria-hidden="true" />
      <img
        src={site.photo}
        alt={site.fullName}
        class="relative size-11 rounded-full border border-accent/40 object-cover"
        width="44"
        height="44"
      />
    </span>
  )
}
