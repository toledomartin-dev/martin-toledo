---
import fs from 'node:fs';
import path from 'node:path';
import { site, t, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].about;
// Sin foto no mostramos nada: las iniciales ya están en el logo
const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public', site.photo));
---

{
  hasPhoto && (
    <button
      type="button"
      class="group relative block size-11 shrink-0 cursor-pointer rounded-full"
      data-lightbox={site.photoFull}
      data-lightbox-alt={ui.photoAlt}
      aria-label={ui.zoom}
    >
      <svg class="orbit" viewBox="0 0 44 44" aria-hidden="true"><circle class="orbit-ring" cx="22" cy="22" r="20.5" pathLength="1"></circle><circle class="orbit-sat" cx="22" cy="1.5" r="2"></circle></svg>
      <picture>
        <source srcset="/img/foto-avatar.avif" type="image/avif" />
        <source srcset="/img/foto-avatar.webp" type="image/webp" />
        <img
          src="/img/foto-avatar.jpg"
          alt={site.fullName}
          class="relative size-11 rounded-full border border-accent/40 object-cover transition-transform group-hover:scale-110"
          width="44"
          height="44"
        />
      </picture>
    </button>
  )
}
