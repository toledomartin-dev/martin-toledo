---
import { t, type Lang } from '../i18n/content';
import { getNotes, notesBase } from '../lib/notes';
import NoteCard from './NoteCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].notes;
const notes = (await getNotes(lang)).slice(0, 3);
---

<section id="notas" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <div class="reveal flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
      <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>
      <p class="mt-4 text-muted">{ui.intro}</p>
    </div>
    <a href={notesBase(lang)} class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline">
      {ui.all} <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="mt-14 grid gap-4 md:grid-cols-3">
    {notes.map((note, i) => <NoteCard note={note} lang={lang} delay={i * 0.06} />)}
  </div>
</section>
