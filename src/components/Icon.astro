---
// Íconos de línea para la interfaz (flechas y tilde), en lugar de caracteres de texto:
// se ven iguales en cualquier fuente y se alinean con el texto que acompañan.
interface Props {
  name: 'arrow-left' | 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'check';
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;
const paths = {
  'arrow-left': 'M19 12H5M12 19l-7-7 7-7',
  'arrow-right': 'M5 12h14M12 5l7 7-7 7',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  'arrow-down': 'M12 5v14M5 12l7 7 7-7',
  check: 'm5 12 5 5L20 7',
};
---

<svg class:list={['shrink-0', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]}></path>
</svg>
