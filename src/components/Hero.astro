---
import { t, type Lang } from '../i18n/content';
import Photo from './Photo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].hero;
const city = t[lang].city;
---

<!-- La sección es alta para que el scroll "recorra" el viaje: la Tierra gira hasta Córdoba y se vuelve el mapa -->
<section id="hero" class="relative h-[240svh]" data-labels={JSON.stringify({ vehicle: city.vehicle, reported: city.reported, seconds: city.seconds })}>
  <div class="sticky top-0 h-svh overflow-hidden">
    <!-- Fallback sin WebGL: un brillo suave -->
    <div
      class="pointer-events-none absolute top-1/2 right-[-10%] size-[640px] -translate-y-1/2 rounded-full bg-accent/15 blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <canvas id="particles" class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 [&.is-ready]:opacity-100" aria-hidden="true"></canvas>
    <!-- Mientras llegan las partículas: el mismo globo, quieto, dibujado en 2D sin Three.js -->
    <canvas class="hero-ghost absolute inset-0 size-full" aria-hidden="true"></canvas>
    <!-- Sobre las partículas: nombres de las ciudades en el globo y la tarjeta del vehículo señalado -->
    <div class="pointer-events-none absolute inset-0 z-10 overflow-hidden font-mono text-[11px]" aria-hidden="true">
      <span data-place="cordoba" class="absolute top-0 left-0 opacity-0"
        ><span class="block -translate-x-1/2 -translate-y-[calc(100%+12px)] rounded-full border border-accent/50 bg-bg/80 px-2 py-0.5 whitespace-nowrap text-fg backdrop-blur"
          >{city.cordoba}</span
        ></span
      >
      <span data-place="sanjuan" class="absolute top-0 left-0 opacity-0"
        ><span class="block -translate-x-[calc(100%+10px)] -translate-y-1/2 rounded-full border border-line bg-bg/80 px-2 py-0.5 whitespace-nowrap text-muted backdrop-blur"
          >{city.sanJuan}</span
        ></span
      >
      <span data-place="server" class="absolute top-0 left-0 opacity-0"
        ><span class="block translate-x-[18px] -translate-y-1/2 rounded-full border border-accent/50 bg-bg/80 px-2 py-0.5 whitespace-nowrap text-fg backdrop-blur"
          >{city.server}</span
        ></span
      >
      <span data-place="tip" class="absolute top-0 left-0 opacity-0 transition-opacity duration-200"
        ><span class="block -translate-x-1/2 -translate-y-[calc(100%+14px)] rounded-lg border border-line bg-card/95 px-2.5 py-1.5 whitespace-nowrap text-fg shadow-lg"></span
      ></span>
    </div>
    <!-- Degradé para leer bien el texto sobre las partículas -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg via-bg/40 to-transparent lg:bg-gradient-to-r lg:from-bg lg:via-bg/50 lg:to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto flex h-full max-w-6xl items-end px-4 pb-16 sm:px-6 lg:items-center lg:pb-0">
      <!-- Escena 1: presentación -->
      <div data-scene="1" class="max-w-xl will-change-transform">
        <div class="flex items-center gap-3" data-enter style="--i:0">
          <Photo lang={lang} />
          <p class="inline-flex items-center gap-2 rounded-full border border-line bg-card/70 px-3 py-1 text-xs text-muted backdrop-blur">
            <span class="relative flex size-2">
              <span class="anim-pulse absolute inline-flex size-full rounded-full bg-accent"></span>
              <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
            </span>
            {ui.location}
          </p>
        </div>

        <h1 class="display text-gradient mt-6 text-5xl sm:text-6xl lg:text-7xl" data-enter style="--i:1">{ui.headline}</h1>
        <p class="mt-6 max-w-md text-base leading-relaxed text-muted sm:text-lg" data-enter style="--i:2">
          <span class="text-fg">Martín Toledo</span> — {ui.role}. {ui.sub}
        </p>

        <div class="mt-9 flex flex-wrap gap-3" data-enter style="--i:3">
          <a href="#proyectos" class="btn-glow magnetic inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold">
            {ui.ctaProjects}
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
          </a>
          <!-- Un solo botón de CV: se despliega hacia arriba para no quedar cortado al pie del hero -->
          <div class="relative" data-cv-menu>
            <button
              type="button"
              class="magnetic inline-flex items-center gap-2 rounded-full border border-line bg-card/70 px-6 py-3 text-sm font-semibold backdrop-blur transition-colors hover:border-accent/60 aria-expanded:border-accent/60"
              aria-expanded="false"
              aria-controls="cv-options"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path></svg>
              {ui.ctaCv}
              <svg class="size-3.5 transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 15 6-6 6 6"></path></svg>
            </button>
            <ul id="cv-options" class="pop-menu absolute bottom-full left-0 z-10 mb-2 min-w-full rounded-2xl border border-line bg-bg/90 p-1.5 whitespace-nowrap shadow-[0_20px_50px_-20px_rgba(0,0,0,.6)] backdrop-blur-xl">
              <li style="--i:1">
                <a href={t[lang].cvPage} class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-muted transition-colors hover:bg-card hover:text-fg focus-visible:bg-card focus-visible:text-fg">
                  <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  {ui.ctaCvOnline}
                </a>
              </li>
              <li style="--i:0">
                <a href={t[lang].cvFile} download={t[lang].cvName} class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-muted transition-colors hover:bg-card hover:text-fg focus-visible:bg-card focus-visible:text-fg">
                  <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14"></path></svg>
                  {ui.ctaCvDownload}
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Escena 2: el mapa (aparece con el scroll) -->
      <div
        data-scene="2"
        class="pointer-events-none absolute inset-x-4 bottom-16 max-w-md opacity-0 sm:inset-x-6 lg:top-1/2 lg:bottom-auto lg:-translate-y-1/2"
      >
        <p class="font-mono text-xs tracking-widest text-accent uppercase">{city.kicker}</p>
        <h2 class="display text-gradient mt-4 text-4xl sm:text-5xl">{city.title}</h2>
        <p class="mt-5 leading-relaxed text-muted">{city.text}</p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted">
          <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-[#ffe9d6]"></span>{city.legendPoints}</li>
          <li class="flex items-center gap-2"><span class="size-2 rounded-full bg-accent shadow-[0_0_10px_var(--accent)]"></span>{city.legendVehicles}</li>
          <li class="flex items-center gap-2"><span class="size-2.5 rounded-full border border-accent"></span>{city.legendPings}</li>
        </ul>
      </div>
    </div>

    <!-- Indicador de scroll -->
    <div data-scene="hint" class="reduce-hide absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-muted lg:flex">
      <span class="font-mono text-[10px] tracking-[0.3em] uppercase">Scroll</span>
      <span class="h-10 w-px overflow-hidden bg-line">
        <span class="anim-shimmer block h-full w-full" style="background-size:100% 200%"></span>
      </span>
    </div>

    <p data-scene="credit" class="absolute right-4 bottom-3 font-mono text-[10px] text-muted/70 opacity-0 sm:right-6">
      {city.credit}
    </p>
  </div>
</section>

<script>
  import { getGpuContext } from '../scripts/gpu';
  import { CORDOBA, IDLE_TILT, START_SPIN, landPoints, rotate, toXYZ } from '../scripts/globe';
  import { bindMenu } from '../scripts/menu';

  const cv = document.querySelector<HTMLElement>('[data-cv-menu]')!;
  bindMenu(cv.querySelector('button')!, cv.querySelector('ul')!);

  const section = document.getElementById('hero')!;
  const canvas = document.getElementById('particles') as HTMLCanvasElement;
  const s1 = section.querySelector<HTMLElement>('[data-scene="1"]')!;
  const s2 = section.querySelector<HTMLElement>('[data-scene="2"]')!;
  const hint = section.querySelector<HTMLElement>('[data-scene="hint"]');
  const credit = section.querySelector<HTMLElement>('[data-scene="credit"]')!;
  const ramp = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)));

  // Las dos escenas de texto se cruzan según el avance del scroll
  const paint = (p: number) => {
    const out = ramp(p, 0.05, 0.25);
    const inn = ramp(p, 0.5, 0.75);
    section.style.setProperty('--ghost-out', String(out));
    s1.style.opacity = String(1 - out);
    s1.style.transform = `translateY(${-out * 40}px)`;
    s1.style.visibility = out >= 1 ? 'hidden' : 'visible';
    s2.style.opacity = String(inn);
    s2.style.transform = `translateY(${(1 - inn) * 40}px)`;
    credit.style.opacity = String(inn * 0.8);
    if (hint) hint.style.opacity = String(1 - ramp(p, 0.02, 0.12));
  };

  const scrollProgress = () => {
    const travel = section.offsetHeight - window.innerHeight;
    return Math.min(1, Math.max(0, -section.getBoundingClientRect().top / Math.max(1, travel)));
  };

  // Globo provisorio: mismos continentes, giro, inclinación, tamaño y lugar que el de Three.js
  // (cámara de 35° a 7 de distancia, radio 1,55), así el cambio a las partículas no se nota.
  // Mientras espera, los puntos se encienden en una onda que nace en Córdoba y después algunos
  // titilan, como datos que llegan. No gira: no hay nada que sincronizar con el globo real.
  const ghost = section.querySelector<HTMLCanvasElement>('canvas.hero-ghost')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Dot = { x: number; y: number; a: number; r: number; accent: boolean; delay: number; phase: number };
  let dots: Dot[] = [];
  let colors = { dot: '', accent: '' };
  let size = { w: 0, h: 0, dpr: 1 };

  const buildGhost = () => {
    const w = ghost.clientWidth;
    const h = ghost.clientHeight;
    const dpr = Math.min(window.devicePixelRatio, 2);
    ghost.width = w * dpr;
    ghost.height = h * dpr;
    size = { w, h, dpr };
    const css = getComputedStyle(document.documentElement);
    colors = { dot: css.getPropertyValue('--fg').trim(), accent: css.getPropertyValue('--accent').trim() };
    const wide = w >= 1024;
    const cx = w / 2 + (wide ? 0.38 : 0) * (w / 2);
    const cy = h / 2 - (wide ? 0.02 : 0.32) * (h / 2);
    const unit = h / 2 / (7 * Math.tan((17.5 * Math.PI) / 180));
    const project = (p: number[]) => {
      const [x, y, z] = rotate(p, START_SPIN, IDLE_TILT);
      const k = (7 / (7 - z * 1.55)) * 1.55 * unit;
      return [cx + x * k, cy - y * k, z];
    };
    const [ox, oy] = project(toXYZ(CORDOBA.lat, CORDOBA.lon));
    const n = wide ? 2400 : 2200;
    const land = landPoints(n);
    const reach = Math.hypot(w, h) * 0.5;
    dots = Array.from({ length: n }, (_, i) => {
      const [x, y, z] = project([land[i * 3], land[i * 3 + 1], land[i * 3 + 2]]);
      return {
        x,
        y,
        a: 0.06 + 0.66 * Math.max(0, z * 0.5 + 0.5) ** 1.5,
        r: i % 5 ? 0.9 : 1.2,
        accent: i % 14 === 0,
        // La onda sale de Córdoba: cuanto más lejos, más tarde se enciende (con algo de azar)
        delay: (Math.hypot(x - ox, y - oy) / reach) * 1.8 + Math.random() * 0.3,
        phase: Math.random() * 100,
      };
    });
  };

  // t: segundos desde que empezó la onda (Infinity = todo encendido y quieto)
  const drawGhost = (t: number) => {
    const g = ghost.getContext('2d');
    if (!g) return;
    g.setTransform(size.dpr, 0, 0, size.dpr, 0, 0);
    g.clearRect(0, 0, size.w, size.h);
    for (const d of dots) {
      const on = Math.min(1, Math.max(0, (t - d.delay) / 0.35));
      if (on <= 0) continue;
      // Titileo: de vez en cuando un punto se enciende más, como un dato que llega
      const blink = Number.isFinite(t) ? Math.max(0, Math.sin(t * 1.6 + d.phase)) ** 24 : 0;
      g.globalAlpha = Math.min(1, d.a * on * (1 + blink * 2.5));
      g.fillStyle = d.accent || blink > 0.5 ? colors.accent : colors.dot;
      g.beginPath();
      g.arc(d.x, d.y, d.r * (1 + blink * 0.8) * (0.6 + 0.4 * on), 0, Math.PI * 2);
      g.fill();
    }
  };

  // La animación corre a ~30 cuadros por segundo y se corta cuando llegan las partículas
  // (o a los 8 s, en equipos que no las cargan): después queda dibujado quieto
  let t0 = 0;
  let raf = 0;
  let lastFrame = 0;
  const animate = (now: number) => {
    const t = (now - t0) / 1000;
    if (canvas.classList.contains('is-ready') || t > 8) return drawGhost(Infinity);
    if (now - lastFrame >= 33) {
      lastFrame = now;
      drawGhost(t);
    }
    raf = requestAnimationFrame(animate);
  };
  const startGhost = () => {
    cancelAnimationFrame(raf);
    buildGhost();
    if (reducedMotion) return drawGhost(Infinity);
    t0 = performance.now();
    raf = requestAnimationFrame(animate);
  };

  // Arranca junto con la entrada del texto (después de la pantalla de carga, si la hay)
  const root = document.documentElement;
  if (root.classList.contains('enter-wait')) {
    buildGhost();
    const waitGo = new MutationObserver(() => {
      if (root.classList.contains('enter-wait')) return;
      waitGo.disconnect();
      startGhost();
    });
    waitGo.observe(root, { attributes: true, attributeFilter: ['class'] });
  } else {
    startGhost();
  }
  window.addEventListener('resize', () => {
    buildGhost();
    drawGhost(Infinity);
  });
  // Cambio de tema: solo se redibuja con los colores nuevos (no se repite la onda)
  let theme = root.classList.contains('light');
  new MutationObserver(() => {
    if (root.classList.contains('light') === theme) return;
    theme = !theme;
    buildGhost();
    drawGhost(Infinity);
  }).observe(root, { attributes: true, attributeFilter: ['class'] });

  const fallback = () => window.addEventListener('scroll', () => paint(scrollProgress()), { passive: true });

  // Las partículas son un extra: arrancan con la primera interacción (mouse, toque, scroll) o a
  // los 3,5 s, cuando la página ya está cargada y responde. Así el contenido nunca compite con
  // Three.js. Antes de descargarlo (~130 KB) se comprueba que el equipo pueda con él.
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const lowEnd = nav.connection?.saveData || (nav.deviceMemory ?? 8) < 4;
  const events = ['pointermove', 'pointerdown', 'touchstart', 'scroll', 'keydown'] as const;
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    events.forEach((ev) => window.removeEventListener(ev, start));
    const run = () => {
      const gl = getGpuContext(canvas);
      if (!gl) return fallback();
      import('../scripts/particles')
        .then(({ initParticles }) => {
          const place = (name: string) => section.querySelector<HTMLElement>(`[data-place="${name}"]`)!;
          return initParticles({
            canvas,
            gl,
            section,
            onProgress: paint,
            overlay: { cordoba: place('cordoba'), sanJuan: place('sanjuan'), server: place('server'), tip: place('tip'), labels: JSON.parse(section.dataset.labels!) },
          });
        })
        .then((ok) => (ok ? canvas.classList.add('is-ready') : fallback()))
        .catch(fallback);
    };
    'requestIdleCallback' in window ? requestIdleCallback(run, { timeout: 800 }) : setTimeout(run, 100);
  };

  if (lowEnd) {
    fallback();
  } else {
    const arm = () => {
      events.forEach((ev) => window.addEventListener(ev, start, { passive: true, once: true }));
      setTimeout(start, 3500);
    };
    // Además de esperar a que la página cargue, se espera a que termine la entrada del texto: si
    // Three.js arranca en el medio (por ejemplo, porque el mouse ya se está moviendo), la traba
    const settled = () => (document.readyState === 'complete' ? Promise.resolve() : new Promise((r) => window.addEventListener('load', r, { once: true })));
    const entrance = () =>
      new Promise<void>((resolve) => {
        if (!root.classList.contains('enter-wait')) return resolve();
        const watch = new MutationObserver(() => {
          if (root.classList.contains('enter-wait')) return;
          watch.disconnect();
          resolve();
        });
        watch.observe(root, { attributes: true, attributeFilter: ['class'] });
      });
    Promise.all([settled(), entrance().then(() => new Promise((r) => setTimeout(r, 1200)))]).then(arm);
  }
  paint(scrollProgress());
</script>
