---
import Hero from './Hero.astro';
import Bento from './Bento.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Stack from './Stack.astro';
import Talk from './Talk.astro';
import Notes from './Notes.astro';
import Guestbook from './Guestbook.astro';
import Contact from './Contact.astro';
import type { Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<!-- Volver al sitio clásico: los proyectos ya no ofrecen "Volver a la consola" -->
<script is:inline>
  try {
    sessionStorage.removeItem('from-console');
  } catch (e) {}
</script>
<Hero lang={lang} />
<About lang={lang} />
<Bento lang={lang} />
<Experience lang={lang} />
<Stack lang={lang} />
<Talk lang={lang} />
<Notes lang={lang} />
<Guestbook lang={lang} />
<Contact lang={lang} />
