---
import { t, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t[lang].experience;
---

<section id="experiencia" class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
  <div class="grid gap-14 lg:grid-cols-[1fr_1.6fr]">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">{ui.kicker}</p>
      <h2 class="display text-gradient mt-4 text-4xl sm:text-6xl">{ui.title}</h2>

      <div class="glass mt-10 p-6">
        <p class="font-mono text-[10px] tracking-widest text-muted uppercase">{ui.education.title}</p>
        <p class="mt-3 font-medium">{ui.education.degree}</p>
        <p class="text-sm text-muted">{ui.education.school}</p>
        <p class="mt-2 font-mono text-xs text-muted">{ui.education.period}</p>
      </div>
    </div>

    <ol class="space-y-4">
      {
        ui.items.map((job, i) => (
          <li class="glass reveal p-7 sm:p-8" style={`--d:${i * 0.08}s`}>
            <p class="font-mono text-xs text-muted">{job.period}</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight sm:text-2xl">{job.role}</h3>
            <p class="text-accent">{job.company}</p>
            <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-muted">
              {job.points.map((pt) => (
                <li class="flex gap-3">
                  <svg class="mt-0.5 size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                  {pt}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
